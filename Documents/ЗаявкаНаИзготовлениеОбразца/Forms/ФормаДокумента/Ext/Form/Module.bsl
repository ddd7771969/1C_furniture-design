&НаКлиенте
Перем МассивАдресовКартинок, ВсегоКартинокОбразца, НомерКартинкиОбразца, ИзменилисьФайлы, МассивДанных;

&НаКлиенте
Процедура ИнформацияОКартинках(ТекущийНомерКартинки = 0)

	ВсегоКартинок = омКартинкиНаСервере.ПолучитьИнформациюОКартинках(Объект.Ссылка, Истина);
	НомерКартинки = ТекущийНомерКартинки;

КонецПроцедуры // ИнформацияОКартинках()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	омЗаполнениеРеквизиов.ЗаполнитьРеквизитыСтандартные(Объект);

	Если Параметры.Ключ.Пустая() Тогда
		Объект.Дата 									= ТекущаяДата();
		Объект.СтатусЗаявки								= Перечисления.СтатусыЗаявкиНаОбразец.ВРаботе;
	КонецЕсли;
	
	омКомментарииНаСервере.СоздатьЭлементыИРеквизитыНаФорме(ЭтаФорма, Элементы.ГруппаКомментарий, Ложь); 
	ДополнительныеПараметры 				= Неопределено;
	Этаформа.Комментарий_авто 				= омКомментарииНаСервере.Получить_HTML_комментарий(Объект.Комментарии, , , ДополнительныеПараметры);
	Элементы.ГруппаКомментарий.Заголовок 	= омКомментарийКлиентСервер.ПолучитьЗаголовокСтраницы(ДополнительныеПараметры);
	Элементы.ГруппаКомментарий.Видимость 	= Ложь; 
	
	Элементы.Производство.Доступность 	= РольДоступна("ПолныеПрава") ИЛИ РольДоступна("НачальникПроизводства");
	Элементы.ФормаПринятие.Доступность 	= Объект.Проведен;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Объект.Файлы.Очистить();
	
	Для каждого х Из МассивДанных Цикл
	
		ЗаполнитьЗначенияСвойств(Объект.Файлы.Добавить(), х);	
	
	КонецЦикла;
	
	Если ИзменилисьФайлы Тогда
		
		ИзменилисьФайлы = Ложь;

		МаксимальныйИндекс = Объект.Файлы.Количество() - 1;
		
		ИзменилсяНомерПоПорядку = Новый Массив;
		ПредыдущиеЗначения 		= Новый Массив;
		НовыеКартинки			= Новый Массив;
		
		Для х = 0 по МаксимальныйИндекс Цикл
			
			ТекущаяСтрока = Объект.Файлы[х];
			
			Если ТекущаяСтрока.НовыйФайл Тогда
				НовыеКартинки.Добавить(Новый Структура("Картинка, Расширение, ИмяФайла, ТекущийИндекс"
				, ТекущаяСтрока.Картинка, ТекущаяСтрока.Расширение, ТекущаяСтрока.ИмяФайла, ТекущаяСтрока.НомерСтроки));
				ТекущаяСтрока.НовыйФайл = Ложь;
			Иначе
				
				Если ТекущаяСтрока.НачальныйИндексСтроки = ТекущаяСтрока.НомерСтроки Тогда
					ПредыдущиеЗначения.Добавить(ТекущаяСтрока.НомерСтроки); 
				Иначе
					ИзменилсяНомерПоПорядку.Добавить(Новый Структура("НачальныйИндекс, ТекущийИндекс", ТекущаяСтрока.НачальныйИндексСтроки, ТекущаяСтрока.НомерСтроки));	
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	
		ЗаписатьФайлыНаСервере(Объект.Ссылка, ИзменилсяНомерПоПорядку, ПредыдущиеЗначения, НовыеКартинки);
		
		НачальныйИндексСтроки = 1;
		Для каждого х Из Объект.Файлы Цикл
			
			х.НачальныйИндексСтроки = НачальныйИндексСтроки;
			НачальныйИндексСтроки = НачальныйИндексСтроки + 1;
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьФайлыНаСервере(ОбъектТЗ, ИзменилсяНомерПоПорядку, ПредыдущиеЗначения, НовыеКартинки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КартинкиОбъектов.НомерПоПорядку КАК НомерПоПорядку,
		|	ЛОЖЬ КАК Обработан
		|ИЗ
		|	РегистрСведений.КартинкиОбъектов КАК КартинкиОбъектов
		|ГДЕ
		|	КартинкиОбъектов.ОбъектТЗ = &ОбъектТЗ";
	
	Запрос.УстановитьПараметр("ОбъектТЗ", ОбъектТЗ);
	
	ТекущиеЗначение = Запрос.Выполнить().Выгрузить();
	
	Для каждого х Из ИзменилсяНомерПоПорядку Цикл
	
		МенеджерЗаписи = РегистрыСведений.КартинкиОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбъектТЗ = ОбъектТЗ;
		МенеджерЗаписи.НомерПоПорядку = х.НачальныйИндекс;
		МенеджерЗаписи.Прочитать();
		
	    МенеджерЗаписи.НомерПоПорядку = х.ТекущийИндекс;
		
		НайденаяСтрока = ТекущиеЗначение.Найти(х.ТекущийИндекс, "НомерПоПорядку");
		
		Если НЕ НайденаяСтрока = Неопределено Тогда
			НайденаяСтрока.Обработан = Истина;
		КонецЕсли;
		
	КонецЦикла;	
	
	Для каждого х Из ПредыдущиеЗначения Цикл
	
		НайденаяСтрока = ТекущиеЗначение.Найти(х, "НомерПоПорядку");
		
		Если НЕ НайденаяСтрока = Неопределено Тогда
			НайденаяСтрока.Обработан = Истина;
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого х Из НовыеКартинки Цикл
		
		МенеджерЗаписи = РегистрыСведений.КартинкиОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбъектТЗ 		= ОбъектТЗ;
		МенеджерЗаписи.НомерПоПорядку 	= х.ТекущийИндекс;
		МенеджерЗаписи.Расширение 		= х.Расширение;
		МенеджерЗаписи.ИмяФайла 		= х.ИмяФайла;
		МенеджерЗаписи.Картинка 		= Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(х.Картинка));
		
		НайденаяСтрока = ТекущиеЗначение.Найти(х, "НомерПоПорядку");
		
		Если НЕ НайденаяСтрока = Неопределено Тогда
			НайденаяСтрока.Обработан = Истина;
		КонецЕсли;
		
		МенеджерЗаписи.Записать();

	КонецЦикла; 
	
	Для каждого х Из ТекущиеЗначение Цикл
	
		Если НЕ х.Обработан Тогда
		
			МенеджерЗаписи = РегистрыСведений.КартинкиОбъектов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ОбъектТЗ = ОбъектТЗ;
			МенеджерЗаписи.НомерПоПорядку 	= х.НомерПоПорядку; 
			
			МенеджерЗаписи.Удалить();
		
		КонецЕсли;	
	
	КонецЦикла;
		
КонецПроцедуры // ЗаписатьФайлыНаСервере(ИзменилсяНомерПоПорядку, ПредыдущиеЗначения, НовыеКартинки)
 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МассивАдресовКартинок = Новый Массив;
	
	ВсегоКартинокОбразца = 0;
	НомерКартинкиОбразца = 0; 
	
	ИзменилисьФайлы 	= Ложь;
	
	НачальныйИндексСтроки = 1;
	Для каждого х Из Объект.Файлы Цикл
		
		х.НачальныйИндексСтроки = НачальныйИндексСтроки;
		НачальныйИндексСтроки = НачальныйИндексСтроки + 1;
		
	КонецЦикла;

КонецПроцедуры 

