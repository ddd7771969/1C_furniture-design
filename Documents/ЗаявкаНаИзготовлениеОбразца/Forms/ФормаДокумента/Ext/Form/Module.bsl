&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	МассивДанных = Новый Массив;
	
	Для каждого х Из Объект.Файлы Цикл
	
		Данные = Новый Структура();
		Данные.Вставить("НомерСтроки", 				х.НомерСтроки);
		Данные.Вставить("ИмяФайла", 				х.ИмяФайла);
		Данные.Вставить("Картинка", 				х.Картинка);
		Данные.Вставить("НовыйФайл", 				х.НовыйФайл);
		Данные.Вставить("Загружен", 				х.Загружен);
		Данные.Вставить("Расширение", 				х.Расширение);
		Данные.Вставить("НачальныйИндексСтроки", 	х.НачальныйИндексСтроки);
		
		МассивДанных.Добавить(Данные);
	КонецЦикла;
КонецПроцедуры






