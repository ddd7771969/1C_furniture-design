&НаКлиенте
Процедура ИзделиеЗаказчикаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Возврат;
	
	Если ЗначениеЗаполнено(Объект.Проект) Тогда
		
		ДополнительныеПараметры = Новый Структура("Отказ, ТолькоНеИспользованые, НомерПоПорядку" ,Ложь ,Ложь ,0);
		омИзделиеЗаказчикаКлиент.ОткрытьПодборИзделияЗаказчика(Объект, ЭтаФорма, Неопределено, СтандартнаяОбработка, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораИзделияЗаказчика(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;                         
	
	Объект.ИзделиеЗаказчика = Результат;	
	
КонецПроцедуры // ПослеВыбораИзделияЗаказчика()

&НаКлиенте
Процедура КартинкаВЛево(Команда)
	НомерКартинкиОбразца = НомерКартинкиОбразца - 1;
	ВывестиКартинкуПослеСмещения();
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВПраво(Команда)
	НомерКартинкиОбразца = НомерКартинкиОбразца + 1;
	ВывестиКартинкуПослеСмещения();
КонецПроцедуры

&НаКлиенте
Процедура ВывестиКартинкуПослеСмещения()
	ТД = Элементы.Образцы.ТекущиеДанные;

	Если ТД = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТД.Образец) Тогда
		
		ВывестиКартинкиОбразца(ТД.Образец);
		
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОбразцыПриАктивизацииСтроки(Элемент)
	
	ТД = Элементы.Образцы.ТекущиеДанные;
	
	КартинкаОбразца 		= Неопределено;
	ВсегоКартинокОбразца 	= 0;
	НомерКартинкиОбразца 	= 0;
	ОписаниеНомерКартинки 	= "";
	
	Если ТД = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТД.Образец) Тогда
		
		ВывестиКартинкиОбразца(ТД.Образец);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВывестиКартинкиОбразца(Образец)

	ОбразецНайден = Ложь;
	
	Для каждого КартинкиОбразца Из МассивАдресовКартинок Цикл
		
		Если КартинкиОбразца.Образец = Образец Тогда
			ОбразецНайден = Истина;
			ВывестиКартинкуОбразца(КартинкиОбразца, НомерКартинкиОбразца);
		КонецЕсли;	
		
	КонецЦикла;
	
	Если НЕ ОбразецНайден Тогда
		
		КартинкиОбразца = ПолучитьДанныеКартинки(Образец, ЭтаФорма.УникальныйИдентификатор);
		МассивАдресовКартинок.Добавить(КартинкиОбразца);
		ВывестиКартинкуОбразца(КартинкиОбразца, НомерКартинкиОбразца);
		
	КонецЕсли;


КонецПроцедуры 

&НаКлиенте
Процедура ВывестиКартинкуОбразца(КартинкиОбразца, НомерКартинкиОбразца)
	
	Если КартинкиОбразца = Неопределено Тогда
		
		КартинкаОбразца = Неопределено;
		ВсегоКартинокОбразца = 0;
		НомерКартинкиОбразца = 0;
		
	Иначе
		
		ВсегоКартинокОбразца = КартинкиОбразца.МассивАдресов.Количество();
		
		Если ВсегоКартинокОбразца = 0 Тогда
			Элементы.КартинкаВлево.Доступность 	= Ложь;
			Элементы.КартинкаВправо.Доступность = Ложь;
		Иначе	
			Элементы.КартинкаВлево.Доступность 	= НомерКартинкиОбразца > 0;
			Элементы.КартинкаВправо.Доступность = НомерКартинкиОбразца < ВсегоКартинокОбразца - 1;
			
			КартинкаОбразца 		= КартинкиОбразца.МассивАдресов[НомерКартинкиОбразца].Картинка;
			ОписаниеНомерКартинки 	= КартинкиОбразца.МассивАдресов[НомерКартинкиОбразца].Описание + " (" + (НомерКартинкиОбразца + 1) + "/" + ВсегоКартинокОбразца + ")";
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПолучитьДанныеКартинки(Образец, УникальныйИдентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КартинкиОбъектов.Картинка КАК Картинка,
		|	КартинкиОбъектов.Описание КАК Описание
		|ИЗ
		|	РегистрСведений.КартинкиОбъектов КАК КартинкиОбъектов
		|ГДЕ
		|	КартинкиОбъектов.ОбъектТЗ = &ОбъектТЗ
		|
		|УПОРЯДОЧИТЬ ПО
		|	КартинкиОбъектов.НомерПоПорядку";
	
	Запрос.УстановитьПараметр("ОбъектТЗ", Образец);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КартинкиОбразца = Новый Структура("Образец, МассивАдресов", Образец, Новый Массив);
	
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("Описание", Выборка.Описание);
		СтруктураДанных.Вставить("Картинка", (ПоместитьВоВременноеХранилище(Выборка.Картинка.Получить(), УникальныйИдентификатор)));
		КартинкиОбразца.МассивАдресов.Добавить(СтруктураДанных);
	КонецЦикла;
	
	Возврат КартинкиОбразца;
	
КонецФункции // ПолучитьДанныеКартинки()

&НаКлиенте
Процедура ОбразцыПриИзменении(Элемент)
	ОбразцыПриАктивизацииСтроки(Элемент);
КонецПроцедуры

