&НаКлиенте
Процедура ВывестиКартинкуНаФорму(ТД)

	Если ПустаяСтрока(ТД.Картинка) Тогда
	
		Элементы.КартинкаФайла.Видимость 	= Ложь;	
		Элементы.ПолеPDF.Видимость 			= Ложь;	
		
		Возврат;
	
	КонецЕсли;
	
	ТипФайла = омКартинкиНаСервереКлиенте.ПолучитьТипФайлаПоРасширению(ТД.Расширение);
	
	Если ТипФайла = "picture" Тогда
		
		Элементы.КартинкаФайла.Видимость 	= Истина;	
		Элементы.ПолеPDF.Видимость 			= Ложь;
		КартинкаФайла 						= ТД.Картинка;
		
	ИначеЕсли ТипФайла = "pdf" Тогда
		
		Элементы.КартинкаФайла.Видимость 	= Ложь;	
		Элементы.ПолеPDF.Видимость 			= Истина;
		ИмяВременногоФайла = омPDF_Клиент.ПоказатьФайлПоАдресуХранилища(ТД.Картинка, ПолеPDF);	
		
	ИначеЕсли ТипФайла = "xls" Тогда
		

	Иначе	         
		Элементы.КартинкаФайла.Видимость 	= Ложь;	
		Элементы.ПолеPDF.Видимость 			= Ложь;	
	КонецЕсли;
	

КонецПроцедуры // ВывестиКартинку(ТД)

