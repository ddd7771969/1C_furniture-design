&НаКлиенте
Процедура ПриложитьФайл(Команда)
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбора.Фильтр = омКартинкиНаСервереКлиенте.ПолучитьСтрокуДляВыбораКартинок();
	ДиалогВыбора.Фильтр = ДиалогВыбора.Фильтр  + "|Файлы pdf (*.pdf)|*.pdf";
	ДиалогВыбора.Заголовок 						= "Выберите файл";
	ДиалогВыбора.ПредварительныйПросмотр 		= Истина;
	ДиалогВыбора.ПроверятьСуществованиеФайла 	= Истина;
	ДиалогВыбора.ИндексФильтра 					= 0; 
	ДиалогВыбора.МножественныйВыбор				= Ложь;
	
	Если ДиалогВыбора.Выбрать() Тогда
		
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
		
		Файл = Новый Файл(ИмяФайла);
		
		НС = Объект.Файлы.Добавить();
		НС.Расширение 	= Файл.Расширение;
		НС.НовыйФайл 	= Истина;
		НС.ИмяФайла 	= Файл.ИмяБезРасширения;
		НС.Загружен 	= Истина;
		НС.Картинка 	= омКартинкиНаКлиенте.ПолучитьАдресКартинкиИзФайла(ИмяФайла, ЭтаФорма.УникальныйИдентификатор);
		
		ИзменилисьФайлы = Истина;

		Модифицированность = Истина;
	КонецЕсли;     
КонецПроцедуры

