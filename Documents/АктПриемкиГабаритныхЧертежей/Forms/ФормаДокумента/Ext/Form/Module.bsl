&НаКлиенте
Процедура ГабаритныеЧертежиПередНачаломИзменения(Элемент, Отказ)
	
	ТД = Элемент.ТекущиеДанные;
	
	Если Элемент.ТекущийЭлемент.Имя = "ГабаритныеЧертежиЗадачаПроверить" Тогда
	
		Отказ = Истина;
		
		
		Если Не ТД = Неопределено Тогда
		
			ПоказатьЗначение(, ТД.ЗадачаПроверить);	
		
		КонецЕсли;
	
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ГабаритныеЧертежиГабаритныйЧертеж" Тогда
		
		Если Объект.Проведен Тогда
		
			Отказ = Истина;
			Если Не ТД = Неопределено Тогда
				ПоказатьЗначение(, ТД.ГабаритныйЧертеж);	
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Отказ = Объект.Проведен;
	КонецЕсли;
	
КонецПроцедуры

