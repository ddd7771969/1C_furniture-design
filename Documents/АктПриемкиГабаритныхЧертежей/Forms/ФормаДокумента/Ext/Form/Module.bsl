&НаКлиенте
Перем ТекущийПользователь;

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	омЗаполнениеРеквизиов.ЗаполнитьРеквизитыСтандартные(Объект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.НовыйСтатус = Перечисления.СтатусыЗамера.Рабочий;	
	Иначе
		ЗаполнитьЗадачиПроверить(Объект.ГабаритныеЧертежи, Объект.Ссылка);
		
		Если Объект.Проведен Тогда
			Элементы.Группа2.ТолькоПросмотр = Истина;	
			КоманднаяПанель.ТолькоПросмотр 	= Истина;	
		КонецЕсли;
	КонецЕсли;
	                              
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьЗадачиПроверить(ТаблицаГабаритныеЧертежи, СсылкаНаАкт)

	ПустаяСсылкаЗадача = Задачи.ПроверитьГабаритныеЧертежи.ПустаяСсылка();
	
	Для каждого х Из ТаблицаГабаритныеЧертежи Цикл
	
		х.ЗадачаПроверить = ПустаяСсылкаЗадача;
	    х.ЗадачаВыполнена = Ложь;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АктПриемкиГабаритныхЧертежейГабаритныеЧертежи.ГабаритныйЧертеж КАК ГабаритныйЧертеж,
		|	ПроверитьГабаритныеЧертежи.Ссылка КАК ЗадачаПроверить,
		|	ПроверитьГабаритныеЧертежи.Выполнена КАК ЗадачаВыполнена
		|ИЗ
		|	Документ.АктПриемкиГабаритныхЧертежей.ГабаритныеЧертежи КАК АктПриемкиГабаритныхЧертежейГабаритныеЧертежи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ПроверитьГабаритныеЧертежи КАК ПроверитьГабаритныеЧертежи
		|		ПО АктПриемкиГабаритныхЧертежейГабаритныеЧертежи.ГабаритныйЧертеж = ПроверитьГабаритныеЧертежи.ОбъектТЗ
		|ГДЕ
		|	ПроверитьГабаритныеЧертежи.Основание = &СсылкаНаАкт
		|	И АктПриемкиГабаритныхЧертежейГабаритныеЧертежи.Ссылка = &СсылкаНаАкт";
	
	Запрос.УстановитьПараметр("СсылкаНаАкт", СсылкаНаАкт);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отбор = Новый Структура("ГабаритныйЧертеж", );
	
	Пока Выборка.Следующий() Цикл
		
		Отбор.ГабаритныйЧертеж = выборка.ГабаритныйЧертеж;
		НайденыеСтроки = ТаблицаГабаритныеЧертежи.НайтиСтроки(Отбор);
		
		Для каждого х Из НайденыеСтроки Цикл
			ЗаполнитьЗначенияСвойств(х, Выборка);		
		КонецЦикла;
		
	КонецЦикла;
	

КонецПроцедуры


