&НаКлиенте
Перем ТипДействияСтрокой, ИмяДействияДляФайла, МассивСоставовВсехКомпозиций;

Функция ПолучитьОбъектыПроекта(Проект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = Новый Структура("ЗадачиПКД, ЗадачиРКД, Производство, СоставКомпозиций", );

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Задачи_ПКД.ОбъектТЗ КАК ОбъектТЗ,
		|	Задачи_ПКД.Ссылка КАК Задача,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних.Конструктор КАК Конструктор,
		|	Задачи_ПКД.ТипЗадачи КАК ТипЗадачи
		|ИЗ
		|	Задача.Задачи_ПКД КАК Задачи_ПКД
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО Задачи_ПКД.ОбъектТЗ = ДанныеКомплектаСрезПоследних.Комплект
		|ГДЕ
		|	Задачи_ПКД.ТипЗадачи В(&ТипыЗадач)
		|	И НЕ Задачи_ПКД.Выполнена
		|	И Задачи_ПКД.Проект = &Проект
		|
		|УПОРЯДОЧИТЬ ПО
		|	Задачи_ПКД.ОбъектТЗ.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Задачи_РКД.ОбъектТЗ КАК ОбъектТЗ,
		|	Задачи_РКД.Ссылка КАК Задача,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних.Конструктор КАК Конструктор,
		|	Задачи_РКД.ТипЗадачи КАК ТипЗадачи,
		|	ЛОЖЬ КАК ЭтоКомпозиция,
		|	Задачи_РКД.Выполнена КАК ЗадачаВыполнена,
		|	ДанныеКомплектаСрезПоследних.Комплект.Наименование КАК Наименование
		|ПОМЕСТИТЬ втРКД
		|ИЗ
		|	Задача.Задачи_РКД КАК Задачи_РКД
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО Задачи_РКД.ОбъектТЗ = ДанныеКомплектаСрезПоследних.Комплект
		|ГДЕ
		|	Задачи_РКД.Проект = &Проект
		|	И НЕ Задачи_РКД.Выполнена
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	КанбанКарточки.Ресурс,
		|	ЗНАЧЕНИЕ(Задача.Задачи_РКД.ПустаяСсылка),
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование,
		|	ДанныеКомплектаСрезПоследних.Конструктор,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадачКонструирования.ПустаяСсылка),
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	КанбанКарточки.Ресурс.Наименование
		|ИЗ
		|	РегистрСведений.КанбанПереходКарточки.СрезПоследних КАК КанбанПереходКарточкиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КанбанКарточки КАК КанбанКарточки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КанбанРазделители КАК КанбанРазделители
		|			ПО КанбанКарточки.УИД = КанбанРазделители.УИДКарточка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|			ПО КанбанКарточки.Ресурс = ДанныеКомплектаСрезПоследних.Комплект
		|			ЛЕВОЕ СОЕДИНЕНИЕ Задача.Задачи_РКД КАК Задачи_РКД
		|			ПО КанбанКарточки.Ресурс = Задачи_РКД.ОбъектТЗ
		|		ПО КанбанПереходКарточкиСрезПоследних.УИДКарточка = КанбанКарточки.УИД
		|ГДЕ
		|	КанбанРазделители.Проект = &Проект
		|	И КанбанПереходКарточкиСрезПоследних.УИДКудаКолонка В(&УИДКудаКолонка)
		|	И (Задачи_РКД.Ссылка ЕСТЬ NULL
		|			ИЛИ Задачи_РКД.Выполнена)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втРКД.ОбъектТЗ КАК ОбъектТЗ,
		|	втРКД.Задача КАК Задача,
		|	втРКД.ТекущаяСтадия КАК ТекущаяСтадия,
		|	втРКД.Конструктор КАК Конструктор,
		|	втРКД.ТипЗадачи КАК ТипЗадачи,
		|	втРКД.ЭтоКомпозиция КАК ЭтоКомпозиция,
		|	втРКД.ЗадачаВыполнена КАК ЗадачаВыполнена,
		|	втРКД.Наименование КАК Наименование
		|ИЗ
		|	втРКД КАК втРКД
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	ТипыЗадач = омЗадачиПКДПовтор.ТипыЗадачКонструктора(Ложь);
	
	Для каждого х Из омЗадачиПКДПовтор.ТипыЗадачКонструктораВедущий() Цикл
		ТипыЗадач.Добавить(х);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Проект", 	Проект);
	Запрос.УстановитьПараметр("ТипыЗадач", 	ТипыЗадач);
	Запрос.УстановитьПараметр("УИДКудаКолонка", омКанбанДоскиНаСервереПовтор.ПолучитьУИДКолонокДоски(омКанбанДоскиНаСервереПовтор.ПолучитьУИДДоски("УИДДоскиПроизводство")));
	
	Результат = Запрос.ВыполнитьПакет();
	СтруктураДанных.ЗадачиПКД 	= ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат[0].Выгрузить());
	
	Если ТребуетсяПересогласование Тогда
		СтруктураДанных.ЗадачиРКД   = ОбщегоНазначения.ТаблицаЗначенийВМассив(ПолучитьКомпозицииРКД(Результат[2].Выгрузить(), СтруктураДанных));
	Иначе
		СтруктураДанных.ЗадачиРКД	= ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат[2].Выгрузить());
	КонецЕсли;
	 
	Возврат СтруктураДанных; 
	 
КонецФункции // ПолучитьОбъектыПроекта()

Функция ПолучитьКомпозицииРКД(ТекущиеЗадачиРКД, СтруктураДанных)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияКомплект.Ссылка КАК Комплект,
		|	ИзделияКомплект.Наименование КАК КомплектНаименование,
		|	ИзделияКомплект.Родитель.Композиция КАК Композиция,
		|	ИзделияКомплект.Родитель.Композиция.Наименование КАК КомпозицияНаименование,
		|	ДанныеКомплектаСрезПоследних.Конструктор КАК Конструктор,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.Наименование КАК ТекущаяСтадия,
		|	Задачи_ПКД.Ссылка КАК ЗадачаПКД,
		|	Задачи_ПКД.Выполнена КАК ЗадачаВыполнена,
		|	Задачи_ПКД.ТипЗадачи КАК ТипЗадачи
		|ИЗ
		|	Справочник.ИзделияКомплект КАК ИзделияКомплект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО (ДанныеКомплектаСрезПоследних.Комплект = ИзделияКомплект.Родитель.Композиция)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.Задачи_ПКД КАК Задачи_ПКД
		|		ПО (Задачи_ПКД.ОбъектТЗ = ИзделияКомплект.Ссылка)
		|ГДЕ
		|	ИзделияКомплект.Ссылка В(&Комплект)
		|	И НЕ(ИзделияКомплект.Родитель.Композиция ЕСТЬ NULL
		|				ИЛИ ИзделияКомплект.Родитель.Композиция = ЗНАЧЕНИЕ(Справочник.Композиции.ПустаяСсылка))";
	
	Запрос.УстановитьПараметр("Комплект", ТекущиеЗадачиРКД.ВыгрузитьКолонку("ОбъектТЗ"));
	
	СтруктураДанных.СоставКомпозиций = Запрос.Выполнить().Выгрузить();
	СтруктураДанных.СоставКомпозиций.Индексы.Добавить("Комплект");
	
	СтруктураДанных.ЗадачиРКД = ТекущиеЗадачиРКД.СкопироватьКолонки("Задача, ТекущаяСтадия, Конструктор, ТипЗадачи, ЗадачаВыполнена, ЭтоКомпозиция");
	СтруктураДанных.ЗадачиРКД.Колонки.Добавить("ОбъектТЗ");
	
	Отбор = Новый Структура("Комплект", );
		
	Для каждого ДанныеКомплекта Из ТекущиеЗадачиРКД Цикл
		
		Отбор.Комплект = ДанныеКомплекта.ОбъектТЗ;
		
		НайденыеСтроки = СтруктураДанных.СоставКомпозиций.НайтиСтроки(Отбор);
		
		Если НайденыеСтроки.Количество() = 0 Тогда
		
			ЗаполнитьЗначенияСвойств(СтруктураДанных.ЗадачиРКД.Добавить(), ДанныеКомплекта);
			
		Иначе
			
			Если СтруктураДанных.ЗадачиРКД.Найти(НайденыеСтроки[0].Композиция, "ОбъектТЗ") = Неопределено Тогда
				//ОбъектТЗ, Задача, ТекущаяСтадия, Конструктор, ТипЗадачи, ЗадачаВыполнена, ЭтоКомпозиция
				НС = СтруктураДанных.ЗадачиРКД.Добавить();
				НС.ОбъектТЗ 		= НайденыеСтроки[0].Композиция;
				НС.Задача			= НайденыеСтроки[0].ЗадачаПКД;
				НС.ЗадачаВыполнена	= НайденыеСтроки[0].ЗадачаВыполнена;
				НС.ТекущаяСтадия	= НайденыеСтроки[0].ТекущаяСтадия;
				НС.ТипЗадачи		= НайденыеСтроки[0].ТипЗадачи;
				НС.Конструктор		= НайденыеСтроки[0].Конструктор;
				НС.ЭтоКомпозиция	= Истина;
				
			КонецЕсли;	
		
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДанных.СоставКомпозиций = ОбщегоНазначения.ТаблицаЗначенийВМассив(СтруктураДанных.СоставКомпозиций);
	
	Возврат СтруктураДанных.ЗадачиРКД;
	
КонецФункции // ПолучитьКомпозицииРКД()

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	
	ОбъектТЗ = ПредопределенноеЗначение("Справочник.Композиции.ПустаяСсылка");
	
	ЗадачиПКД.Очистить();
	ЗадачиРКД.Очистить();
	ВыбранноеЗначение = Неопределено;
	
	Если ЗначениеЗаполнено(Проект) Тогда
		СтруктураДанных = ПолучитьОбъектыПроекта(Проект);
		
		Для каждого Значение Из СтруктураДанных.ЗадачиПКД Цикл
			ЗаполнитьЗначенияСвойств(ЗадачиПКД.Добавить(), Значение);	
		КонецЦикла;
		
		Для каждого Значение Из СтруктураДанных.ЗадачиРКД Цикл
			ЗаполнитьЗначенияСвойств(ЗадачиРКД.Добавить(), Значение);	
		КонецЦикла;
		
		МассивСоставовВсехКомпозиций = Новый Массив;
		
		Если НЕ СтруктураДанных.СоставКомпозиций = Неопределено Тогда
			
			Для каждого Значение Из СтруктураДанных.СоставКомпозиций Цикл
				СтруктураСостава = Новый Структура("Отметка, Комплект, Композиция, ТекущаяСтадия, ЗадачаПКД", Истина);
				ЗаполнитьЗначенияСвойств(СтруктураСостава, Значение);
				МассивСоставовВсехКомпозиций.Добавить(СтруктураСостава);
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
    Элементы.ЗадачиПКД.Видимость 				= ЗадачиПКД.Количество() > 0;
    Элементы.ГруппаРКД.Видимость 				= ЗадачиРКД.Количество() > 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Открыта() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры // ПослеЗакрытияВыбораФайла()

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры) = Тип("ДанныеФормыСтруктура") И Параметры.Свойство("НаимеаниеДействия") Тогда
		НаимеаниеДействия = Параметры.НаимеаниеДействия;	
	КонецЕсли;
	
    Элементы.ЗадачиПКД.Видимость 					= Ложь;
    Элементы.ГруппаРКД.Видимость 					= Ложь;  
	
КонецПроцедуры

#Область БлокировкаТаблиц

&НаКлиенте
Процедура ЗадачиПКДПередНачаломИзменения(Элемент, Отказ)

	Отказ = Истина;
	
	ТД = Элементы.ЗадачиПКД.ТекущиеДанные;
	
	Если НЕ ТД = Неопределено Тогда
		ВыбранноеЗначение 							= ТД.Задача;
		ТребуетсяПересогласование 					= Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗадачиПКДПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиПКДПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиРКДПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиРКДПередНачаломИзменения(Элемент, Отказ)

	Отказ = Истина;
	
	ТД = Элементы.ЗадачиРКД.ТекущиеДанные;
	
	Если НЕ ТД = Неопределено Тогда
		ВыбранноеЗначение = ?(ЗначениеЗаполнено(ТД.Задача), ТД.Задача, ТД.ОбъектТЗ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗадачиРКДПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СоставКомпозицииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры
	
&НаКлиенте
Процедура СоставКомпозицииПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТД = Элементы.СоставКомпозиции.ТекущиеДанные;
	
	Если НЕ ТД = Неопределено Тогда
		ТД.Отметка = НЕ ТД.Отметка;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоставКомпозицииПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти 

&НаКлиенте
Процедура ДобавитьИзменения(Команда)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		ТекущиеСостояниеЗадачи = омЗадачиПКДСервер.ТекущиеСостояниеЗадачи(ВыбранноеЗначение).ТекущиеСостояние;
		
		Если ТекущиеСостояниеЗадачи = ПредопределенноеЗначение("Перечисление.СостоянияЗадач.ВРаботеКонструктора")
					ИЛИ ТекущиеСостояниеЗадачи = ПредопределенноеЗначение("Перечисление.СостоянияЗадач.ПриостановкаКонструктором") Тогда
			ТипДействияСтрокой = "";
		Иначе
			ВыбранноеЗначениеТип = ТипЗнч(ВыбранноеЗначение);
			Если (ВыбранноеЗначениеТип = Тип("ЗадачаСсылка.Задачи_РКД") ИЛИ ВыбранноеЗначениеТип = Тип("СправочникСсылка.Композиции")) И ТребуетсяПересогласование Тогда
				ТипДействияСтрокой = "ПереносВ_ПКД_Дизайнером" + НаимеаниеДействия;
			Иначе
				ТипДействияСтрокой = "СбросДизайнером" + НаимеаниеДействия;
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураДанных = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);
		
		ОповещенияПослеЗакрытияВыбораФайла = Новый ОписаниеОповещения("ПослеЗакрытияВыбораФайла", ЭтаФорма);
		
		ПараметрыДоработки = Новый Структура("ОбъектДействий, ДействиеПриОкончании, НаименованиеДействия, ИмяДействияДляФайла"
		, ВыбранноеЗначение, ТипДействияСтрокой, "Перемещение файла в каталог PDM", ИмяДействияДляФайла);
		ОткрытьФорму("ОбщаяФорма.ФормаПереносИнформацииВPDM", ПараметрыДоработки, , , , , ОповещенияПослеЗакрытияВыбораФайла, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ПоказатьПредупреждение(, "Не выбрано значение");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НаимеаниеДействия 	= "КорректировкаДизайнера" Тогда
		ЭтаФорма.Заголовок 	= "Корректировка Дизайнера";
		ТипДействияСтрокой 	= "КорректировкаДизайнер";
		ИмяДействияДляФайла = "Корректировка";
	Иначе
		ЭтаФорма.Заголовок 	= "Изменение Заказчиком";
		ТипДействияСтрокой 	= "РедакцияДизайнер";
		ИмяДействияДляФайла = "Редакция";
	КонецЕсли;
	
	МассивСоставовВсехКомпозиций = Новый Массив;
	
КонецПроцедуры

&НаКлиенте
Процедура ТребуетсяПересогласованиеПриИзменении(Элемент)
	ПроектПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиРКДПриАктивизацииСтроки(Элемент)
	
	Отказ = Истина;
	
	СоставКомпозиции.Очистить();
	
	ТД = Элементы.ЗадачиРКД.ТекущиеДанные;
	
	Если НЕ ТД = Неопределено  И ТД.ЭтоКомпозиция Тогда
		
		Для каждого х Из МассивСоставовВсехКомпозиций Цикл
		
			Если х.Композиция = ТД.ОбъектТЗ Тогда
			
				ЗаполнитьЗначенияСвойств(СоставКомпозиции.Добавить(), х);	
			
			КонецЕсли;		
		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметиитьВсеКомплекты(Команда)
	УчтановитьЗначенияФлагов(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СброситьВсеКомплекты(Команда)
	УчтановитьЗначенияФлагов(Ложь);
КонецПроцедуры  

&НаКлиенте
Процедура УчтановитьЗначенияФлагов(Значение)

	Для каждого х Из СоставКомпозиции Цикл
		х.Отметка = Значение;	
	КонецЦикла;	

КонецПроцедуры


