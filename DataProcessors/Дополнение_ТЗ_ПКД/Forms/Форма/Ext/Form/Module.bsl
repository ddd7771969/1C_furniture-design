&НаКлиенте
Перем ТипДействияСтрокой, ИмяДействияДляФайла;

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	
	ОбъектТЗ = ПредопределенноеЗначение("Справочник.Композиции.ПустаяСсылка");
	
	ЗадачиПКД.Очистить();
	ЗадачиРКД.Очистить();
	ВыбранноеЗначение = Неопределено;
	
	Если ЗначениеЗаполнено(Проект) Тогда
		СтруктураДанных = ПолучитьОбъектыПроекта(Проект);
		
		Для каждого Значение Из СтруктураДанных.ЗадачиПКД Цикл
			ЗаполнитьЗначенияСвойств(ЗадачиПКД.Добавить(), Значение);	
		КонецЦикла;
		
		Для каждого Значение Из СтруктураДанных.ЗадачиРКД Цикл
			ЗаполнитьЗначенияСвойств(ЗадачиРКД.Добавить(), Значение);	
		КонецЦикла;
		
	КонецЕсли;
	
    Элементы.ЗадачиПКД.Видимость = ЗадачиПКД.Количество() > 0;
    Элементы.ЗадачиРКД.Видимость = ЗадачиРКД.Количество() > 0;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОбъектыПроекта(Проект)
	
	СтруктураДанных = Новый Структура("ЗадачиПКД, ЗадачиРКД, Производство", );

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ИзделияКомплект.Родитель.Композиция = ЗНАЧЕНИЕ(Справочник.Композиции.ПустаяСсылка)
		|			ТОГДА ИзделияКомплект.Ссылка
		|		ИНАЧЕ ИзделияКомплект.Родитель.Композиция
		|	КОНЕЦ КАК Ссылка
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Справочник.ИзделияКомплект КАК ИзделияКомплект
		|ГДЕ
		|	НЕ ИзделияКомплект.ЭтоГруппа
		|	И ИзделияКомплект.Проект = &Проект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт.Ссылка КАК ОбъектТЗ,
		|	Задачи_ПКД.Ссылка КАК Задача,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних.Конструктор КАК Конструктор,
		|	Задачи_ПКД.ТипЗадачи КАК ТипЗадачи
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.Задачи_ПКД КАК Задачи_ПКД
		|		ПО вт.Ссылка = Задачи_ПКД.ОбъектТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО вт.Ссылка = ДанныеКомплектаСрезПоследних.Комплект
		|ГДЕ
		|	Задачи_ПКД.ТипЗадачи В(&ТипыЗадач)
		|	И НЕ Задачи_ПКД.Выполнена
		|
		|УПОРЯДОЧИТЬ ПО
		|	вт.Ссылка.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт.Ссылка КАК ОбъектТЗ,
		|	Задачи_РКД.Ссылка КАК Задача,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних.Конструктор КАК Конструктор,
		|	Задачи_РКД.ТипЗадачи КАК ТипЗадачи
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.Задачи_РКД КАК Задачи_РКД
		|		ПО вт.Ссылка = Задачи_РКД.ОбъектТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО вт.Ссылка = ДанныеКомплектаСрезПоследних.Комплект
		|ГДЕ
		|	Задачи_РКД.ТипЗадачи В(&ТипыЗадач)
		|	И НЕ Задачи_РКД.Выполнена
		|
		|УПОРЯДОЧИТЬ ПО
		|	вт.Ссылка.Наименование";
	
	ТипыЗадач = омЗадачиПКДПовтор.ТипыЗадачКонструктора(Ложь);
	
	Для каждого х Из омЗадачиПКДПовтор.ТипыЗадачКонструктораВедущий() Цикл
		ТипыЗадач.Добавить(х);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Проект", 	Проект);
	Запрос.УстановитьПараметр("ТипыЗадач", 	ТипыЗадач);
	
	Результат = Запрос.ВыполнитьПакет();
	СтруктураДанных.ЗадачиПКД = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат[1].Выгрузить());
	СтруктураДанных.ЗадачиРКД = ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат[2].Выгрузить());
	 
	Возврат СтруктураДанных; 
	 
КонецФункции // ПолучитьОбъектыПроекта()

&НаКлиенте
Процедура ПослеЗакрытияВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Открыта() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры // ПослеЗакрытияВыбораФайла()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры) = Тип("ДанныеФормыСтруктура") И Параметры.Свойство("НаимеаниеДействия") Тогда
		НаимеаниеДействия = Параметры.НаимеаниеДействия;	
	КонецЕсли;
	
    Элементы.ЗадачиПКД.Видимость = Ложь;
    Элементы.ЗадачиРКД.Видимость = Ложь;
	
КонецПроцедуры


#Область БлокировкаТаблиц

&НаКлиенте
Процедура ЗадачиПКДПередНачаломИзменения(Элемент, Отказ)

	Отказ = Истина;
	
	ТД = Элементы.ЗадачиПКД.ТекущиеДанные;
	
	Если НЕ ТД = Неопределено Тогда
		ВыбранноеЗначение = ТД.Задача;	
		Элементы.ТребуетсяПересогласование.Видимость = Ложь;
		ТребуетсяПересогласование = Ложь;
	КонецЕсли;

КонецПроцедуры

