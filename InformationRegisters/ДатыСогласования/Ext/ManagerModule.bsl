Процедура ЗаписатьДатуСогласования(Комплект, ДатаСогласованияАрхитектором = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ *
		|ИЗ
		|	РегистрСведений.ДатыСогласования.СрезПоследних(, Комплект = &Комплект) КАК ДатыСогласованияСрезПоследних";
	
	Запрос.УстановитьПараметр("Комплект", Комплект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерЗаписи = РегистрыСведений.ДатыСогласования.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Комплект = Комплект;

	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
	КонецЦикла;
	
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.ДатаСогласованияДизайнером = МенеджерЗаписи.Период;
	
	Если НЕ ДатаСогласованияАрхитектором = Неопределено Тогда
		МенеджерЗаписи.ДатаСогласованияАрхитектором = ДатаСогласованияАрхитектором;
	КонецЕсли;
	
	МенеджерЗаписи.Записать()
	
КонецПроцедуры


