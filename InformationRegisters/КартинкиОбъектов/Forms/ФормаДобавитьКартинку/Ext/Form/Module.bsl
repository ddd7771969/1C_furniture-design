
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектТЗ", ОбъектТЗ);
	
	Если ЗначениеЗаполнено(ОбъектТЗ) Тогда
		Элементы.ОбъектТЗ.Заголовок = ОбъектТЗ.Метаданные().Представление();
	Иначе
		Отказ = Истина
	КонецЕсли; 
	
	омКартинкиНаСервере.СоздатьЭлементыИРеквизитыНаФорме(ЭтаФорма, Элементы.ГруппаКартинки);
	
	
КонецПроцедуры
