Функция ПолучитьНаименованияПроектов(СписокВыбора, ПоказатьВсе = Ложь, СписокСПараметрами = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланДатыСрезПоследних.Параметр КАК Параметр,
	|	ПланДатыСрезПоследних.НаименованиеПараметра КАК НаименованиеПараметра
	|ИЗ
	|	РегистрСведений.ПланДаты.СрезПоследних(, Комплект = НЕОПРЕДЕЛЕНО) КАК ПланДатыСрезПоследних
	|ГДЕ
	|	ПланДатыСрезПоследних.Параметр <> ""&&&&""
	|	И ПланДатыСрезПоследних.НаименованиеПараметра ПОДОБНО ""НП#%""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Параметр";
	
	Если ПоказатьВсе Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПланДатыСрезПоследних.Параметр <> """"", "");	
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(?(ПоказатьВсе, Выборка.НаименованиеПараметра, Выборка.Параметр), СтрЗаменить(Выборка.Параметр, "_", " "));
		
		Если НЕ СписокСПараметрами = Неопределено Тогда
			СписокСПараметрами.Добавить(Выборка.НаименованиеПараметра, Выборка.Параметр);	
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ПолучитьНаименованияПроектов()

Функция ПолучитьНомерОтчетаПоНаименованиею(НаименованиеОтчета, СписокСПараметрами) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланДатыСрезПоследних.НаименованиеПараметра КАК НаименованиеПараметра,
	|	ПланДатыСрезПоследних.Параметр КАК Параметр
	|ИЗ
	|	РегистрСведений.ПланДаты.СрезПоследних(, Комплект = НЕОПРЕДЕЛЕНО) КАК ПланДатыСрезПоследних
	|ГДЕ
	|	ПланДатыСрезПоследних.Параметр = &НаименованиеОтчета
	|	И ПланДатыСрезПоследних.НаименованиеПараметра ПОДОБНО ""НП#%""";
	
	
	Запрос.УстановитьПараметр("НаименованиеОтчета", НаименованиеОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	НомерОтчета = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		НомерОтчета = СтрЗаменить(Выборка.НаименованиеПараметра, "НП#", "");
		СписокСПараметрами.Добавить(Выборка.НаименованиеПараметра, Выборка.Параметр);	
	КонецЦикла;
	
	Возврат НомерОтчета;
	
КонецФункции // ПолучитьНомерОтчетаПоНаименованиею() 

Функция ПреробразоватьПараметрКолонкиВСтруктуру(НаименованиеПараметра, СписокСПараметрамиИменаОтчетов) Экспорт
	
	МасиивДанных = СтрРазделить(НаименованиеПараметра, "#");
	
	Если НЕ МасиивДанных.Количество() = 3 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ПараметрОтчета = "НП#" + МасиивДанных[1]; 
	
	НайденоеЗначение = СписокСПараметрамиИменаОтчетов.НайтиПоЗначению(ПараметрОтчета);
	
	Если НайденоеЗначение = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ДанныеКолонки = СтрРазделить(МасиивДанных[2], "?");
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("НаименованиеОтчета", НайденоеЗначение.Представление);
	СтруктураДанных.Вставить("НомерКолонки", Число(ДанныеКолонки[0]));
	СтруктураДанных.Вставить("ТипПараметра", ДанныеКолонки[1]);
	
	Возврат СтруктураДанных;
	
КонецФункции // ПреробразоватьПараметрКолонкиВСтруктуру()

Функция ПреробразоватьПараметрВСтруктуру(НаименованиеПараметра, СписокСПараметрамиИменаОтчетов) Экспорт
	
	МасиивДанных = СтрРазделить(НаименованиеПараметра, "#");
	
	Если НЕ МасиивДанных.Количество() = 2 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ПараметрОтчета = "НП#" + МасиивДанных[1]; 
	
	НайденоеЗначение = СписокСПараметрамиИменаОтчетов.НайтиПоЗначению(ПараметрОтчета);
	
	Если НайденоеЗначение = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если МасиивДанных[0] = "ИК" Тогда
		ТипПараметра = "ИспользоватьКомпозиции";
	ИначеЕсли МасиивДанных[0] = "ОГ" Тогда
		ТипПараметра = "ОсновнаяГруппировка";
    Иначе
		Возврат Неопределено;	
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("НаименованиеОтчета", 	НайденоеЗначение.Представление);
	СтруктураДанных.Вставить("ТипПараметра", 		ТипПараметра);
	
	Возврат СтруктураДанных;
	
КонецФункции // ПреробразоватьПараметрКолонкиВСтруктуру()

Функция ПолучитьКолонкиОтчета(НаименованиеОтчета) Экспорт
	
	СписокСПараметрамиИменаОтчетов = Новый СписокЗначений;
	
	НомерОтчета = ПолучитьНомерОтчетаПоНаименованиею(НаименованиеОтчета, СписокСПараметрамиИменаОтчетов);
	
	Если НомерОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	КолонкиОтчета = Новый ТаблицаЗначений;
	КолонкиОтчета.Колонки.Добавить("НомерКолонки");	
	КолонкиОтчета.Колонки.Добавить("ТипРасчетногоЗначения");	
	КолонкиОтчета.Колонки.Добавить("НаименованиеКолонки");	
	КолонкиОтчета.Колонки.Добавить("ТипКолонки");	
	КолонкиОтчета.Колонки.Добавить("Сортировка");	
	КолонкиОтчета.Колонки.Добавить("ПоказыватьРучныеЗначения");	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланДатыСрезПоследних.Параметр КАК Параметр,
	|	ПланДатыСрезПоследних.НаименованиеПараметра КАК НаименованиеПараметра,
	|	ПланДатыСрезПоследних.ТипКолонки КАК ТипКолонки,
	|	ПланДатыСрезПоследних.ТипРасчетныхЗначений КАК ТипРасчетныхЗначений,
	|	ПланДатыСрезПоследних.ТипРасчетныхЗначений.ТипКолонки КАК ТипРасчетныхЗначенийТипКолонки
	|ИЗ
	|	РегистрСведений.ПланДаты.СрезПоследних КАК ПланДатыСрезПоследних
	|ГДЕ
	|	ПланДатыСрезПоследних.Комплект = НЕОПРЕДЕЛЕНО
	|	И ПланДатыСрезПоследних.Параметр <> ""&&&&""
	|	И ПланДатыСрезПоследних.НаименованиеПараметра ПОДОБНО &ПрефиксКолонки";
	
	Запрос.УстановитьПараметр("ПрефиксКолонки", "НК#" + НомерОтчета + "#%");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отбор = Новый Структура("НомерКолонки", );
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = ПреробразоватьПараметрКолонкиВСтруктуру(Выборка.НаименованиеПараметра, СписокСПараметрамиИменаОтчетов);
		
		Если СтруктураДанных = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Отбор.НомерКолонки = СтруктураДанных.НомерКолонки;
		НайденыеСтроки = КолонкиОтчета.НайтиСтроки(Отбор);
		
		Если НайденыеСтроки.Количество() = 0 Тогда
			НС = КолонкиОтчета.Добавить();
			НС.НомерКолонки = Отбор.НомерКолонки;
		Иначе
			НС = НайденыеСтроки[0];
		КонецЕсли;
		
		Если СтруктураДанных.ТипПараметра = "Н" Тогда
			НС.НаименованиеКолонки = Выборка.Параметр;
			НС.ТипКолонки = Выборка.ТипКолонки;
			НС.ТипРасчетногоЗначения = Выборка.ТипРасчетныхЗначений;
			НС.ТипКолонки = ?(ЗначениеЗаполнено(Выборка.ТипРасчетныхЗначений), Выборка.ТипРасчетныхЗначенийТипКолонки, Выборка.ТипКолонки);
		ИначеЕсли СтруктураДанных.ТипПараметра = "Сор" Тогда
			НС.Сортировка = Выборка.Параметр;
		ИначеЕсли СтруктураДанных.ТипПараметра = "РЗ" Тогда
			НС.ПоказыватьРучныеЗначения = Выборка.Параметр;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КолонкиОтчета;	
	
КонецФункции // ПолучитьКолонкиОтчета()

Функция ПолучитьКомплектыПроекта(Проект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияКомплект.Ссылка КАК Комплект,
		|	ИзделияКомплект.Наименование КАК Наименование,
		|	ИзделияКомплект.ГабаритныйЧертеж КАК ГабаритныйЧертеж,
		|	ИзделияКомплект.Родитель.Композиция КАК РодительКомпозиция,
		|	ИзделияКомплект.ОсновноеПомещение КАК ОсновноеПомещение,
		|	ИзделияКомплект.Родитель.Композиция.ОсновноеПомещение КАК РодительКомпозицияОсновноеПомещение,
		|	ИзделияКомплект.Родитель.Композиция.ГабаритныйЧертеж КАК РодительКомпозицияГабаритныйЧертеж,
		|	ИзделияКомплект.ОсновноеПомещение.НомерПомещения КАК ОсновноеПомещениеНомерПомещения,
		|	ИзделияКомплект.Родитель.ОсновноеПомещение.НомерПомещения КАК РодительОсновноеПомещениеНомерПомещения
		|ИЗ
		|	Справочник.ИзделияКомплект КАК ИзделияКомплект
		|ГДЕ
		|	ИзделияКомплект.Проект = &Проект";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Возврат ПолучитьПродолжительностьПериодов(Запрос.Выполнить().Выгрузить(), Проект);
	
КонецФункции // ПолучитьКомплектыПроекта()

Функция ПолучитьПродолжительностьПериодов(ТаблицаПроекты, Проект) Экспорт
	
	ОписаниеЧисло 	= Новый ОписаниеТипов("Число");
	ОписаниеДата 	= Новый ОписаниеТипов("Дата");
	
	ТаблицаПроекты.Колонки.Добавить("СрокМонтажаВНеделях", 				ОписаниеЧисло);				
	ТаблицаПроекты.Колонки.Добавить("СрокПроектированияВНеделях", 		ОписаниеЧисло);				
	ТаблицаПроекты.Колонки.Добавить("СрокПроизводстваВНеделях", 		ОписаниеЧисло);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияМонтажаРасчет", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияПроизводстваРасчет",	ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияМонтажа", 			ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияПКД", 				ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияПроизводства", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаСогласованияАрхитектором", 	ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомплектДатаОтказа", 				ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомплектДатаСогласования", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомплектДатаОтправки", 			ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомпозицияДатаОтказа", 			ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомпозицияДатаСогласования", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомпозицияДатаОтправки", 			ОписаниеДата);				
	ТаблицаПроекты.Индексы.Добавить("Комплект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СрокиПоДоговору.ИзделиеЗаказчика КАК ИзделиеЗаказчика,
		|	ИзделияКомплектИзделияЭлемент.Ссылка КАК Комплект,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция КАК Композиция,
		|	СрокиПоДоговору.СрокМонтажаВНеделях КАК СрокМонтажаВНеделях,
		|	СрокиПоДоговору.СрокПроектированияВНеделях КАК СрокПроектированияВНеделях,
		|	СрокиПоДоговору.СрокПроизводстваВНеделях КАК СрокПроизводстваВНеделях,
		|	СрокиПоДоговору.ДатаОкончанияМонтажа КАК ДатаОкончанияМонтажа,
		|	СрокиПоДоговору.ДатаОкончанияПКД КАК ДатаОкончанияПКД,
		|	СрокиПоДоговору.ДатаОкончанияПроизводства КАК ДатаОкончанияПроизводства
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.СрокиПоДоговору КАК СрокиПоДоговору
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИзделияЗаказчика.ИзделияЭлемент КАК ИзделияЗаказчикаИзделияЭлемент
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИзделияКомплект.ИзделияЭлемент КАК ИзделияКомплектИзделияЭлемент
		|			ПО (ИзделияКомплектИзделияЭлемент.ИзделиеЭлемент = ИзделияЗаказчикаИзделияЭлемент.ИзделиеЭлемент)
		|		ПО СрокиПоДоговору.ИзделиеЗаказчика = ИзделияЗаказчикаИзделияЭлемент.Ссылка
		|ГДЕ
		|	ИзделияКомплектИзделияЭлемент.Ссылка В(&мКомплекты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором,
		|	ДатыСогласования.Комплект КАК Комплект
		|ПОМЕСТИТЬ втДатыСогласованияКомплекты
		|ИЗ
		|	РегистрСведений.ДатыСогласования.СрезПоследних(, Комплект В (&мКомплекты)) КАК ДатыСогласования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором,
		|	ДатыСогласования.Комплект КАК Композиция
		|ПОМЕСТИТЬ втДатыСогласованияКомпозиции
		|ИЗ
		|	РегистрСведений.ДатыСогласования.СрезПоследних(, Комплект В (&мКомпозиция)) КАК ДатыСогласования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВнешниеСогласованияЧертежейСрезПоследних.Комплект КАК Комплект,
		|	ВнешниеСогласованияЧертежейСрезПоследних.ДатаОтказа КАК ДатаОтказа,
		|	ВнешниеСогласованияЧертежейСрезПоследних.ДатаОтправки КАК ДатаОтправки,
		|	ВнешниеСогласованияЧертежейСрезПоследних.ДатаСогласования КАК ДатаСогласования
		|ПОМЕСТИТЬ втСогласованиеСЗакзачиком
		|ИЗ
		|	РегистрСведений.ВнешниеСогласованияЧертежей.СрезПоследних(, Комплект.Проект = &Проект) КАК ВнешниеСогласованияЧертежейСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(вт.СрокМонтажаВНеделях) КАК СрокМонтажаВНеделях,
		|	МИНИМУМ(вт.СрокПроектированияВНеделях) КАК СрокПроектированияВНеделях,
		|	МИНИМУМ(вт.СрокПроизводстваВНеделях) КАК СрокПроизводстваВНеделях,
		|	вт.Комплект КАК Комплект,
		|	вт.ДатаОкончанияМонтажа КАК ДатаОкончанияМонтажа,
		|	вт.ДатаОкончанияПКД КАК ДатаОкончанияПКД,
		|	вт.ДатаОкончанияПроизводства КАК ДатаОкончанияПроизводства,
		|	втДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором,
		|	вт.Композиция КАК Композиция,
		|	втДатыСогласованияКомпозиции.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитекторомКопозиция,
		|	втСогласованиеСЗакзачиком.ДатаОтказа КАК КомплектДатаОтказа,
		|	втСогласованиеСЗакзачиком.ДатаОтправки КАК КомплектДатаОтправки,
		|	втСогласованиеСЗакзачиком.ДатаСогласования КАК КомплектДатаСогласования,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтказа КАК КомпозицияДатаОтказа,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтправки КАК КомпозицияДатаОтправки,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаСогласования КАК КомпозицияДатаСогласования
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДатыСогласованияКомплекты КАК втДатыСогласования
		|		ПО вт.Комплект = втДатыСогласования.Комплект
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДатыСогласованияКомпозиции КАК втДатыСогласованияКомпозиции
		|		ПО вт.Композиция = втДатыСогласованияКомпозиции.Композиция
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСогласованиеСЗакзачиком КАК втСогласованиеСЗакзачиком
		|		ПО (вт.Комплект = (ВЫРАЗИТЬ(втСогласованиеСЗакзачиком.Комплект КАК Справочник.ИзделияКомплект)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСогласованиеСЗакзачиком КАК втСогласованиеСЗакзачикомКомпозиции
		|		ПО (вт.Композиция = (ВЫРАЗИТЬ(втСогласованиеСЗакзачикомКомпозиции.Комплект КАК Справочник.Композиции)))
		|
		|СГРУППИРОВАТЬ ПО
		|	вт.Комплект,
		|	вт.ДатаОкончанияМонтажа,
		|	вт.ДатаОкончанияПКД,
		|	вт.ДатаОкончанияПроизводства,
		|	втДатыСогласования.ДатаСогласованияАрхитектором,
		|	вт.Композиция,
		|	втДатыСогласованияКомпозиции.ДатаСогласованияАрхитектором,
		|	втСогласованиеСЗакзачиком.ДатаОтказа,
		|	втСогласованиеСЗакзачиком.ДатаОтправки,
		|	втСогласованиеСЗакзачиком.ДатаСогласования,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтказа,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтправки,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаСогласования";
	
	Запрос.УстановитьПараметр("мКомплекты", 	ТаблицаПроекты.ВыгрузитьКолонку("Комплект"));
	Запрос.УстановитьПараметр("мКомпозиция", 	ТаблицаПроекты.ВыгрузитьКолонку("Композиция"));
	Запрос.УстановитьПараметр("Проект", 		Проект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденаяСтрока = ТаблицаПроекты.Найти(Выборка.Комплект, "Комплект");	
		ЗаполнитьЗначенияСвойств(НайденаяСтрока, Выборка);
		
	КонецЦикла;
	
	ЗаполнитьРасчетныеЗначения(ТаблицаПроекты);
	
	Возврат ТаблицаПроекты;
	
КонецФункции 

Процедура ЗаполнитьРасчетныеЗначения(ТаблицаПроекты)

	ТД 				= НачалоДня(ТекущаяДатаСеанса());
	ГЧПринят 		= Перечисления.СтатусыЗамера.Рабочий;
	СекундВНеделе 	= 7 * 24 * 3600;
	
	Для каждого х Из ТаблицаПроекты Цикл
	
		Если х.КомплектСтатусЗамера = ГЧПринят И ЗначениеЗаполнено(х.КомплектДатаСогласования) Тогда
			КомплектДатаСогласования = х.КомплектДатаСогласования;
		Иначе
			КомплектДатаСогласования = ТД;
		КонецЕсли;
		
		Если х.КомплектСтатусЗамераПомещения = ГЧПринят И ЗначениеЗаполнено(х.КомплектДатаПомещения) Тогда
			КомплектДатаПомещения = х.КомплектДатаПомещения;
		Иначе
			КомплектДатаПомещения = ТД;
		КонецЕсли;
		
		Если х.КомпозицияСтатусЗамера = ГЧПринят И ЗначениеЗаполнено(х.КомпозицияДатаГЧ) Тогда
			КомпозицияДатаГЧ = х.КомпозицияДатаГЧ;
		Иначе
			КомпозицияДатаГЧ = ТД;
		КонецЕсли;
		Если х.КомпозицияСтатусЗамераПомещения = ГЧПринят И ЗначениеЗаполнено(х.КомпозицияДатаПомещения) Тогда
			КомпозицияДатаПомещения = х.КомпозицияДатаПомещения;
		Иначе
			КомпозицияДатаПомещения = ТД;
		КонецЕсли; 
		
		
		х.ДатаОкончанияПроизводстваРасчет   	= КомплектДатаСогласования + СекундВНеделе * х.СрокМонтажаВНеделях;
		
		ДатаОкончанияПроизводстваРасчет 	= Макс(х.ДатаОкончанияПроизводстваРасчет, КомпозицияДатаПомещения);
		х.ДатаОкончанияМонтажаРасчет 		= ДатаОкончанияПроизводстваРасчет + СекундВНеделе * х.СрокМонтажаВНеделях
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьКомплектыИзделияПомещенияПроекта(Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостояниеГЧСрезПоследних.ОбъектЗамера КАК ОбъектЗамера,
		|	СостояниеГЧСрезПоследних.СтатусЗамера КАК СтатусЗамера,
		|	СостояниеГЧСрезПоследних.Период КАК Период
		|ПОМЕСТИТЬ втСтатусГЧ
		|ИЗ
		|	РегистрСведений.СостояниеЗамера.СрезПоследних(, ОбъектЗамера.Проект = &Проект) КАК СостояниеГЧСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Наименование КАК КомплектНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка КАК Комплект,
		|	втСтатусГЧ.СтатусЗамера КАК КомплектСтатусЗамера,
		|	втСтатусГЧ.Период КАК ДатаГЧ,
		|	втСтатусГЧ2.СтатусЗамера КАК КомплектСтатусЗамераПомещения,
		|	втСтатусГЧ2.Период КАК КомплектДатаПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ОсновноеПомещение КАК ОсновноеПомещениеКомплекта,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ОсновноеПомещение.НомерПомещения КАК КомплектОсновноеПомещениеНомерПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж КАК КомплектГабаритныйЧертеж,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж.Наименование КАК КомплектГабаритныйЧертежНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.Ссылка КАК Композиция,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.Наименование КАК КомпозицияНаименование,
		|	втСтатусГЧ1.СтатусЗамера КАК КомпозицияСтатусЗамера,
		|	втСтатусГЧ3.СтатусЗамера КАК КомпозицияСтатусЗамераПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение КАК КомпозицияОсновноеПомещение,
		|	втСтатусГЧ1.Период КАК КомпозицияДатаГЧ,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение.Наименование КАК КомпозицияОсновноеПомещениеНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение.НомерПомещения КАК КомпозицияОсновноеПомещениеНомерПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж КАК КомпозицияГабаритныйЧертеж,
		|	втСтатусГЧ3.Период КАК КомпозицияДатаПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж.Наименование КАК КомпозицияГабаритныйЧертежНаименование,
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка.Наименование КАК ИзделиеЗаказчикаНаименование,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК СостояниеЧертежей
		|ИЗ
		|	Справочник.ИзделияКомплект.ИзделияЭлемент КАК ИзделияКомплектИзделияЭлемент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИзделияЗаказчика.ИзделияЭлемент КАК ИзделияЗаказчикаИзделияЭлемент
		|		ПО ИзделияКомплектИзделияЭлемент.ИзделиеЭлемент = ИзделияЗаказчикаИзделияЭлемент.ИзделиеЭлемент
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж = (ВЫРАЗИТЬ(втСтатусГЧ.ОбъектЗамера КАК Справочник.ГабаритныеЧертежи)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ1
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж = (ВЫРАЗИТЬ(втСтатусГЧ1.ОбъектЗамера КАК Справочник.ГабаритныеЧертежи)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ2
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж = (ВЫРАЗИТЬ(втСтатусГЧ1.ОбъектЗамера КАК Справочник.Помещения)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ3
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение = (ВЫРАЗИТЬ(втСтатусГЧ1.ОбъектЗамера КАК Справочник.Помещения)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО ИзделияКомплектИзделияЭлемент.Ссылка = ДанныеКомплектаСрезПоследних.Комплект
		|ГДЕ
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Проект = &Проект";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Возврат ПолучитьПродолжительностьПериодов(Запрос.Выполнить().Выгрузить(), Проект);
	
КонецФункции // ПолучитьПомещенияПроекта()

Процедура ПолучитьСводнуюТаблицу(ОбластьВывода, Проект) Экспорт
	
	ОбластьВывода.Очистить();
	
	ТаблицаИзделияЗаказчика = ПолучитьИзделияЗаказчика(Проект);
	ТаблицаИзделияЗаказчика.Индексы.Добавить("ИзделиеЗаказчика");
	МассивИзделийЗаказчика 	= ТаблицаИзделияЗаказчика.ВыгрузитьКолонку("ИзделиеЗаказчика");
	ТаблицаПомещений 		= ПолучитьДанныеПомещений(Проект, МассивИзделийЗаказчика);
	ТаблицаСоответствий		= ПолучитьТаблицуСоответствий(МассивИзделийЗаказчика);
	ТаблицаСогласований 	= ПолучитьДанныеСогласования(ТаблицаСоответствий); 
	
	ОписаниеСтрока 	= Новый ОписаниеТипов("Строка");
	ОписаниеЧисло 	= Новый ОписаниеТипов("Число");
	ОписаниеСЗ 		= Новый ОписаниеТипов("СписокЗначений");
	ОписаниеДата 	= Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	
	тзКомплекты = Новый ТаблицаЗначений;
	тзКомплекты.Колонки.Добавить("Композиция", 				Новый ОписаниеТипов("СправочникСсылка.Композиции"));
	тзКомплекты.Колонки.Добавить("КомпозицияНаименование", 	ОписаниеСтрока);
	тзКомплекты.Колонки.Добавить("Комплект", 				Новый ОписаниеТипов("СправочникСсылка.ИзделияКомплект"));
	тзКомплекты.Колонки.Добавить("КомплектНаименование", 	ОписаниеСтрока);
	тзКомплекты.Колонки.Добавить("СписокГЧ", 				Новый ОписаниеТипов("СписокЗначений"));
	тзКомплекты.Колонки.Добавить("ГЧ", 						ОписаниеСтрока);
	тзКомплекты.Колонки.Добавить("ДатаЗамер", 				ОписаниеДата);
	тзКомплекты.Колонки.Добавить("СписокПомещений",			Новый ОписаниеТипов("СписокЗначений"));
	тзКомплекты.Колонки.Добавить("Помещение",				ОписаниеСтрока);
	тзКомплекты.Колонки.Добавить("ДатаПомещениеМонтаж", 	ОписаниеДата);
	тзКомплекты.Колонки.Добавить("ДатаСогласованиеАрхитектор", 	ОписаниеДата);
	тзКомплекты.Колонки.Добавить("ДатаСогласованиеЗаказчик", 	ОписаниеДата);
	тзКомплекты.Колонки.Добавить("ДатаВыложили", 				ОписаниеСтрока);
	тзКомплекты.Колонки.Добавить("ДатаВернули", 				ОписаниеСтрока);
	тзКомплекты.Колонки.Добавить("Статус", 						ОписаниеСтрока);
	
	Макет = Отчеты.ОтчетМенеджера.ПолучитьМакет("МакетПоИзделиямЗаказчика");
	Область = Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Проект = Проект;
	
	ОбластьВывода.Вывести(Область); 
	ОбластьВывода.ФиксацияСверху 	= ОбластьВывода.ВысотаТаблицы;
	ОбластьВывода.ФиксацияСлева 	= 4;
	
	ОтборИзделиеЗаказчика 	= Новый Структура("ИзделиеЗаказчика", );
	ОтборКомпозиция 		= Новый Структура("Композиция", );
	ОтборКомплект 			= Новый Структура("Комплект", );
	
	Область 			= Макет.ПолучитьОбласть("ИзделиеЗаказчика");
	ОбластьКомплект 	= Макет.ПолучитьОбласть("Комплект");
	ОбластьКомозиция 	= Макет.ПолучитьОбласть("Композиция");
	Для каждого ТекущиеИзделие Из ТаблицаИзделияЗаказчика Цикл
		
		ОтборИзделиеЗаказчика.ИзделиеЗаказчика = ТекущиеИзделие.ИзделиеЗаказчика;
		
		СтруктураПомещения 		= ПолучитьДанныеПоПомещению(ОтборИзделиеЗаказчика, ТаблицаПомещений, ТаблицаСоответствий); 
		СтруктураСогласования 	= ПолучитьДанныеПоСогласованию(ОтборИзделиеЗаказчика, ТаблицаСогласований, ТаблицаСоответствий); 
		
		Область.Параметры.Заполнить(ТекущиеИзделие);
		Область.Параметры.Заполнить(СтруктураПомещения);
		Область.Параметры.Заполнить(СтруктураСогласования);
		ОбластьВывода.Вывести(Область, 1, "ИзделиеЗаказчика", Ложь);
		
		
		ЗаполнитьКомплектыИзделия(тзКомплекты, ТаблицаПомещений, ТаблицаСоответствий, ТаблицаСогласований, ОтборИзделиеЗаказчика, ОтборКомпозиция, ОтборКомплект);
		
		Если тзКомплекты.Количество() > 0 Тогда
			
			ОбластьВывода.НачатьГруппуСтрок("ИзделиеЗаказчика", Ложь);
			Для каждого х Из тзКомплекты Цикл
				
				Если ЗначениеЗаполнено(х.Композиция) Тогда
					
					ОбластьКомозиция.Параметры.Заполнить(х);	
					ОбластьВывода.Вывести(ОбластьКомозиция, 2, "ИзделиеЗаказчика", Ложь);
					
				Иначе
					ОбластьКомплект.Параметры.Заполнить(х);	
					ОбластьВывода.Вывести(ОбластьКомплект, 2, "ИзделиеЗаказчика", Ложь);
				КонецЕсли;
				
			КонецЦикла;
			
			ОбластьВывода.ЗакончитьГруппуСтрок();
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ОбластьВывода.Вывести(Макет.ПолучитьОбласть("Подвал")); 

КонецПроцедуры // ПолучитьСводнуюТаблицу()

Функция ПолучитьДанныеПоСогласованию(ОтборИзделиеЗаказчика, ТаблицаСогласований, ТаблицаСоответствий)
	
	ДанныеСогласования = Новый Структура;
	ДанныеСогласования.Вставить("ДатаСогласованиеАрхитектор", Дата(1, 1, 1));
	ДанныеСогласования.Вставить("ДатаСогласованиеЗаказчик", Дата(1, 1, 1));
	ДанныеСогласования.Вставить("ДатаВыложили","");
	ДанныеСогласования.Вставить("ДатаВернули","");
	
	МассивОбъектов = Новый Массив;
	
	Для каждого х Из ТаблицаСоответствий.НайтиСтроки(ОтборИзделиеЗаказчика) Цикл
		
		Если МассивОбъектов.Найти(х.Комплект) = Неопределено Тогда
			МассивОбъектов.Добавить(х.Комплект);
		КонецЕсли;		
		Если МассивОбъектов.Найти(х.Композиция) = Неопределено Тогда
			МассивОбъектов.Добавить(х.Композиция);
		КонецЕсли;		
		
	КонецЦикла;
	
	Для каждого х Из ТаблицаСогласований.СогласованиеАрхитектором Цикл
	
		Если НЕ МассивОбъектов.Найти(х.Комплект) = Неопределено Тогда
			ДанныеСогласования.ДатаСогласованиеАрхитектор = Макс(ДанныеСогласования.ДатаСогласованиеАрхитектор, х.ДатаСогласованияАрхитектором);	
		КонецЕсли;	
	
	КонецЦикла;
	
	Для каждого х Из ТаблицаСогласований.СогласованиеАрхитектором Цикл
	
		Если НЕ МассивОбъектов.Найти(х.Комплект) = Неопределено Тогда
			ДанныеСогласования.ДатаСогласованиеАрхитектор = Макс(ДанныеСогласования.ДатаСогласованиеАрхитектор, х.ДатаСогласованияАрхитектором);	
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого х Из ТаблицаСогласований.СогласованиеЗаказчиком Цикл
		
		Если НЕ МассивОбъектов.Найти(х.Комплект) = Неопределено Тогда
			Если ЗначениеЗаполнено(х.ДатаОтправки) Тогда
				ДанныеСогласования.ДатаВыложили = ДанныеСогласования.ДатаВыложили + ?(ПустаяСтрока(ДанныеСогласования.ДатаВыложили), "", ", ") + Формат(х.ДатаОтправки, "ДФ=dd.MM.yy");	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(х.ДатаОтказа) Тогда
				ДанныеСогласования.ДатаВылДатаВернулиожили = ДанныеСогласования.ДатаВернули + ?(ПустаяСтрока(ДанныеСогласования.ДатаВернули), "", ", ") + Формат(х.ДатаОтказа, "ДФ=dd.MM.yy");	
			КонецЕсли;
			
			ДанныеСогласования.ДатаСогласованиеЗаказчик = Макс(ДанныеСогласования.ДатаСогласованиеЗаказчик, х.ДатаСогласования);	
		КонецЕсли;
		
	КонецЦикла;
	
    Возврат ДанныеСогласования;
КонецФункции // ПолучитьДанныеПоСогласованию(ОтборИзделиеЗаказчика, ТаблицаСогласований, ТаблицаСоответствий)

Процедура ЗаполнитьКомплектыИзделия(тзКомплекты, ТаблицаПомещений, ТаблицаСоответствий, ТаблицаСогласований, ОтборИзделиеЗаказчика, ОтборКомпозиция, ОтборКомплект)

	тзКомплекты.Очистить();
	МассивКомпозиций = Новый Массив;
	
	Для каждого ТекущийКомплект Из ТаблицаСоответствий.НайтиСтроки(ОтборИзделиеЗаказчика) Цикл
		
		НС = тзКомплекты.Добавить();
		ЗаполнитьЗначенияСвойств(НС, ТекущийКомплект); 
		Если ЗначениеЗаполнено(ТекущийКомплект.Композиция) Тогда
			
			Если МассивКомпозиций.Найти(ТекущийКомплект.Композиция) = Неопределено Тогда
				МассивКомпозиций.Добавить(ТекущийКомплект.Композиция);
				ОтборКомпозиция.Композиция = ТекущийКомплект.Композиция; 
				ЗаполнитьКомпозицию(тзКомплекты, ТаблицаПомещений, ТаблицаСоответствий, ТаблицаСогласований, ОтборИзделиеЗаказчика, ОтборКомпозиция);
				
				ЗаполнитьЗначенияСвойств(НС, ПолучитьДанныеПоПомещению(ОтборКомпозиция, ТаблицаПомещений, ТаблицаСоответствий));
				
				МассивКомплектовКомпозиции = Новый Массив;
				
				Для каждого текКомплект Из ТаблицаСоответствий.НайтиСтроки(ОтборКомпозиция) Цикл
				
					Если МассивКомплектовКомпозиции.Найти(текКомплект.Комплект) = Неопределено Тогда
					
						МассивКомплектовКомпозиции.Добавить(текКомплект.Комплект);	
						ОтборКомплект.Комплект = текКомплект.Комплект;
						НС = тзКомплекты.Добавить();
						НС.Комплект = текКомплект.Комплект;
						НС.КомплектНаименование = текКомплект.КомплектНаименование;
						ЗаполнитьЗначенияСвойств(НС, ПолучитьДанныеПоПомещению(ОтборКомплект, ТаблицаПомещений, ТаблицаСоответствий));
					КонецЕсли;	
				
				КонецЦикла;
			
			КонецЕсли;
		Иначе
			ОтборКомплект.Комплект = ТекущийКомплект.Комплект;
			ЗаполнитьЗначенияСвойств(НС, ПолучитьДанныеПоПомещению(ОтборКомплект, ТаблицаПомещений, ТаблицаСоответствий));
			
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьКомпозицию(тзКомплекты, ТаблицаПомещений, ТаблицаСоответствий, ТаблицаСогласований, ОтборИзделиеЗаказчика, ОтборКомпозиция)
	
	
КонецПроцедуры 

Функция ПолучитьДанныеПоПомещению(Отбор, ТаблицаПомещений, ТаблицаСоответствий)

    СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("ГЧ", "");
	СтруктураДанных.Вставить("Статус", "");
	СтруктураДанных.Вставить("СписокГЧ", Новый СписокЗначений);
	СтруктураДанных.Вставить("ДатаЗамер", Неопределено);
	СтруктураДанных.Вставить("Помещение", "");
	СтруктураДанных.Вставить("СписокПомещений", Новый СписокЗначений);
	СтруктураДанных.Вставить("ДатаПомещениеМонтаж", Неопределено);
	
	Если Отбор.Свойство("ИзделиеЗаказчика") Тогда        
	
		НайденыеСтроки = ТаблицаПомещений.НайтиСтроки(Отбор);
		
		Для каждого х Из НайденыеСтроки Цикл
			
			Если ЗначениеЗаполнено(х.ГЧ) И СтруктураДанных.СписокГЧ.НайтиПоЗначению(х.ГЧ) = Неопределено Тогда
				
				СтруктураДанных.СписокГЧ.Добавить(х.ГЧ);
				КоличествоГЧ = СтруктураДанных.СписокГЧ.Количество();
				Если КоличествоГЧ = 1 Тогда
					СтруктураДанных.ГЧ = х.НаименованиеГЧ;
				Иначе	
					СтруктураДанных.ГЧ = "(+" + КоличествоГЧ + ")"; 
				КонецЕсли;
				
				Если НЕ СтруктураДанных.ДатаЗамер = Дата(1, 1, 1) Тогда
					Если СтруктураДанных.ДатаЗамер = Неопределено Тогда
						СтруктураДанных.ДатаЗамер = х.ДатаЗамер;
					Иначе	
						СтруктураДанных.ДатаЗамер = Макс(х.ДатаЗамер, СтруктураДанных.ДатаЗамер);
					КонецЕсли;
						
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(х.Помещение) И СтруктураДанных.СписокПомещений.НайтиПоЗначению(х.Помещение) = Неопределено Тогда
				
				СтруктураДанных.СписокПомещений.Добавить(х.Помещение);
				КоличествоПомещений = СтруктураДанных.СписокПомещений.Количество();
				Если КоличествоПомещений = 1 Тогда
					СтруктураДанных.Помещение = х.НаименованиеПомещение;
				Иначе	
					СтруктураДанных.Помещение = "(+" + КоличествоПомещений + ")"; 
				КонецЕсли;
				
				Если НЕ СтруктураДанных.ДатаПомещениеМонтаж = Дата(1, 1, 1) Тогда
					Если СтруктураДанных.ДатаПомещениеМонтаж = Неопределено Тогда
						СтруктураДанных.ДатаПомещениеМонтаж = х.ДатаПомещениеМонтаж;
					Иначе	
						СтруктураДанных.ДатаПомещениеМонтаж = Макс(х.ДатаПомещениеМонтаж, СтруктураДанных.ДатаПомещениеМонтаж);
					КонецЕсли;
						
				КонецЕсли;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
		НайденыеСтроки = ТаблицаСоответствий.НайтиСтроки(Отбор);
		
		НомерСтатуса = 1000;
		
		Для каждого х Из НайденыеСтроки Цикл
			
			Если НомерСтатуса > х.ТекущаяСтадияНомерПоПорядкуКомплект Тогда
			
				НомерСтатуса = х.ТекущаяСтадияНомерПоПорядкуКомплект;
				СтруктураДанных.Статус = х.ТекущаяСтадияПолноеНаименованиеКомплект;
			
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(х.Композиция) И НомерСтатуса > х.ТекущаяСтадияНомерПоПорядкуКомпозиция Тогда
			
				НомерСтатуса = х.ТекущаяСтадияНомерПоПорядкуКомпозиция;
				СтруктураДанных.Статус = х.ТекущаяСтадияПолноеНаименованиеКомпозиция;
			
			КонецЕсли;
		
		КонецЦикла;
	ИначеЕсли Отбор.Свойство("Комплект") Тогда        

		МассивПомещений = Новый Массив;
		МассивГЧ 		= Новый Массив;
		
		Для каждого х Из ТаблицаСоответствий.НайтиСтроки(Отбор) Цикл
		
			Если МассивПомещений.Найти(х.КомплектПомещение) = Неопределено Тогда
				МассивПомещений.Добавить(х.КомплектПомещение);
			КонецЕсли;	
		
			Если МассивГЧ.Найти(х.КомплектГабаритныйЧертеж) = Неопределено Тогда
				МассивГЧ.Добавить(х.КомплектГабаритныйЧертеж);
			КонецЕсли;
			
			СтруктураДанных.Статус = х.ТекущаяСтадияПолноеНаименованиеКомплект;
		
		КонецЦикла;
		
		ЗаполнитьСтруктуруПомещения(ТаблицаПомещений, МассивГЧ, МассивПомещений, СтруктураДанных);
	ИначеЕсли Отбор.Свойство("Композиция") Тогда        

		МассивПомещений = Новый Массив;
		МассивГЧ 		= Новый Массив;
		
		Для каждого х Из ТаблицаСоответствий.НайтиСтроки(Отбор) Цикл
		
			Если МассивПомещений.Найти(х.КомпозицияПомещение) = Неопределено Тогда
				МассивПомещений.Добавить(х.КомпозицияПомещение);
			КонецЕсли;	
		
			Если МассивГЧ.Найти(х.КомпозицияГабаритныйЧертеж) = Неопределено Тогда
				МассивГЧ.Добавить(х.КомпозицияГабаритныйЧертеж);
			КонецЕсли;
			
			СтруктураДанных.Статус = х.ТекущаяСтадияПолноеНаименованиеКомпозиция; 
				
		КонецЦикла;
		
		ЗаполнитьСтруктуруПомещения(ТаблицаПомещений, МассивГЧ, МассивПомещений, СтруктураДанных);

	КонецЕсли;
	
    Возврат СтруктураДанных;
КонецФункции // ПолучитьДанныеПоПомещению(ОтборКомплект, ТаблицаПомещений) 

Процедура ЗаполнитьСтруктуруПомещения(ТаблицаПомещений, МассивГЧ, МассивПомещений, СтруктураДанных)

	Для каждого х Из ТаблицаПомещений Цикл
		
		Если НЕ МассивПомещений.Найти(х.Помещение) = Неопределено И ЗначениеЗаполнено(х.Помещение) 
			И СтруктураДанных.СписокПомещений.НайтиПоЗначению(х.Помещение) = Неопределено Тогда
			
			СтруктураДанных.СписокПомещений.Добавить(х.Помещение);
			КоличествоПомещений = СтруктураДанных.СписокПомещений.Количество();
			Если КоличествоПомещений = 1 Тогда
				СтруктураДанных.Помещение = х.НаименованиеПомещение;
			Иначе	
				СтруктураДанных.Помещение = "(+" + КоличествоПомещений + ")"; 
			КонецЕсли;
			
			Если СтруктураДанных.ДатаПомещениеМонтаж = Неопределено Тогда
				СтруктураДанных.ДатаПомещениеМонтаж = х.ДатаПомещениеМонтаж;
			Иначе	
				СтруктураДанных.ДатаПомещениеМонтаж = Макс(х.ДатаПомещениеМонтаж, СтруктураДанных.ДатаПомещениеМонтаж);
			КонецЕсли;
			
		КонецЕсли;	
		
		Если НЕ МассивГЧ.Найти(х.ГЧ) = Неопределено И ЗначениеЗаполнено(х.ГЧ) 
			И СтруктураДанных.СписокГЧ.НайтиПоЗначению(х.ГЧ) = Неопределено Тогда
			
			СтруктураДанных.СписокГЧ.Добавить(х.ГЧ);
			КоличествоГЧ = СтруктураДанных.СписокГЧ.Количество();
			Если КоличествоГЧ = 1 Тогда
				СтруктураДанных.ГЧ = х.НаименованиеГЧ;
			Иначе	
				СтруктураДанных.ГЧ = "(+" + КоличествоГЧ + ")"; 
			КонецЕсли;
			
			Если НЕ СтруктураДанных.ДатаЗамер = Дата(1, 1, 1) Тогда
				Если СтруктураДанных.ДатаЗамер = Неопределено Тогда
					СтруктураДанных.ДатаЗамер = х.ДатаЗамер;
				Иначе	
					СтруктураДанных.ДатаЗамер = Макс(х.ДатаЗамер, СтруктураДанных.ДатаЗамер);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеСогласования(ТаблицаСоответствий)

	МассивКомплект = Новый Массив;
	
	Для каждого х Из ТаблицаСоответствий Цикл
	
		Если ЗначениеЗаполнено(х.Комплект) Тогда
		
			Если ЗначениеЗаполнено(х.Композиция) Тогда
				Если МассивКомплект.Найти(х.Композиция) = Неопределено Тогда
					МассивКомплект.Добавить(х.Композиция);	
				КонецЕсли;	
			Иначе
				Если МассивКомплект.Найти(х.Комплект) = Неопределено Тогда
					МассивКомплект.Добавить(х.Комплект);	
				КонецЕсли;	
			КонецЕсли;	
		
		КонецЕсли;	
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнешниеСогласованияЧертежей.Комплект КАК Комплект,
		|	ВнешниеСогласованияЧертежей.ДатаОтказа КАК ДатаОтказа,
		|	ВнешниеСогласованияЧертежей.ДатаОтправки КАК ДатаОтправки,
		|	ВнешниеСогласованияЧертежей.ДатаСогласования КАК ДатаСогласования,
		|	ВнешниеСогласованияЧертежей.Период КАК Период
		|ИЗ
		|	РегистрСведений.ВнешниеСогласованияЧертежей КАК ВнешниеСогласованияЧертежей
		|ГДЕ
		|	ВнешниеСогласованияЧертежей.Комплект В(&Комплект)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыСогласования.Комплект КАК Комплект,
		|	ДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором
		|ИЗ
		|	РегистрСведений.ДатыСогласования.СрезПоследних(, Комплект В (&мКомплекты)) КАК ДатыСогласования
		|ГДЕ
		|	ДатыСогласования.ДатаСогласованияАрхитектором > ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("Комплект", МассивКомплект);
	
	Результат = Запрос.ВыполнитьПакет();
	СогласованиеЗаказчиком 		= Результат[0].Выгрузить();
	СогласованиеАрхитектором 	= Результат[1].Выгрузить();
	
	Возврат Новый Структура("СогласованиеЗаказчиком, СогласованиеАрхитектором", СогласованиеЗаказчиком, СогласованиеАрхитектором); 
	
КонецФункции // ПолучитьДанныеСогласования(ТаблицаСоответствий)

Функция ПолучитьТаблицуСоответствий(МассивИзделийЗаказчика)

	Запрос = Новый Запрос;                                                   
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияКомплектИзделияЭлемент.Ссылка КАК Комплект,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Наименование КАК КомплектНаименование,
		|	ЕСТЬNULL(ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция, НЕОПРЕДЕЛЕНО) КАК Композиция,
		|	ЕСТЬNULL(ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.Наименование, """") КАК КомпозицияНаименование,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадияПолноеНаименованиеКомплект,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия КАК ТекущаяСтадияКомплект,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия КАК ТекущаяСтадияКомпозиция,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадияПолноеНаименованиеКомпозиция,
		|	ВЫРАЗИТЬ(ИзделияЗаказчикаИзделияЭлемент.Ссылка.ПолноеНаименование КАК СТРОКА(100)) КАК ИзделиеЗаказчикаНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж КАК КомплектГабаритныйЧертеж,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ОсновноеПомещение КАК КомплектПомещение,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж КАК КомпозицияГабаритныйЧертеж,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение КАК КомпозицияПомещение,
		|	ЕСТЬNULL(ДанныеКомплектаСрезПоследних.ТекущаяСтадия.НомерПоПорядку, 500) КАК ТекущаяСтадияНомерПоПорядкуКомплект,
		|	ЕСТЬNULL(ДанныеКомплектаСрезПоследних1.ТекущаяСтадия.НомерПоПорядку, 500) КАК ТекущаяСтадияНомерПоПорядкуКомпозиция
		|ИЗ
		|	Справочник.ИзделияЗаказчика.ИзделияЭлемент КАК ИзделияЗаказчикаИзделияЭлемент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИзделияКомплект.ИзделияЭлемент КАК ИзделияКомплектИзделияЭлемент
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|			ПО ИзделияКомплектИзделияЭлемент.Ссылка = ДанныеКомплектаСрезПоследних.Комплект
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних1
		|			ПО ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция = ДанныеКомплектаСрезПоследних1.Комплект
		|		ПО ИзделияЗаказчикаИзделияЭлемент.ИзделиеЭлемент = ИзделияКомплектИзделияЭлемент.ИзделиеЭлемент
		|ГДЕ
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка В(&Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИзделияКомплектИзделияЭлемент.Ссылка,
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия.ПолноеНаименование,
		|	ВЫРАЗИТЬ(ИзделияЗаказчикаИзделияЭлемент.Ссылка.ПолноеНаименование КАК СТРОКА(100)),
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Наименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ОсновноеПомещение,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение,
		|	ЕСТЬNULL(ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.Наименование, """"),
		|	ЕСТЬNULL(ДанныеКомплектаСрезПоследних.ТекущаяСтадия.НомерПоПорядку, 500),
		|	ЕСТЬNULL(ДанныеКомплектаСрезПоследних1.ТекущаяСтадия.НомерПоПорядку, 500)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КомпозицияНаименование,
		|	КомплектНаименование";
	
	Запрос.УстановитьПараметр("Ссылка", МассивИзделийЗаказчика);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьТаблицуСоответствий()

Функция ПолучитьИзделияЗаказчика(Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияЗаказчика.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияЗаказчика.Описание КАК Описание,
		|	ИзделияЗаказчика.РазмерПоТЗ КАК РазмерПоТЗ,
		|	ИзделияЗаказчика.Наименование КАК Наименование,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокМонтажаВНеделях, 0) КАК СрокМонтажа,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокПроектированияВНеделях, 0) КАК СрокПроектирования,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокПроизводстваВНеделях, 0) КАК СрокПроизводства,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокМонтажаВНеделях, 0) + ЕСТЬNULL(СрокиПоДоговору.СрокПроизводстваВНеделях, 0) + ЕСТЬNULL(СрокиПоДоговору.СрокПроектированияВНеделях, 0) КАК СрокДоговора,
		|	ЕСТЬNULL(СрокиПоДоговору.ДатаОкончанияМонтажа, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаМонтажа,
		|	ЕСТЬNULL(СрокиПоДоговору.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
		|	ЕСТЬNULL(СрокиПоДоговору.ДатаОкончанияПроизводства, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПроизводства,
		|	ИзделияЗаказчикаПомещения.Помещение.Наименование КАК ОсновноеПомещение,
		|	ИзделияЗаказчикаПомещения.Помещение.НомерПомещения КАК НомерПомещения
		|ИЗ
		|	Справочник.ИзделияЗаказчика КАК ИзделияЗаказчика
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиПоДоговору КАК СрокиПоДоговору
		|		ПО (СрокиПоДоговору.ИзделиеЗаказчика = ИзделияЗаказчика.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИзделияЗаказчика.Помещения КАК ИзделияЗаказчикаПомещения
		|		ПО (ИзделияЗаказчикаПомещения.Ссылка = ИзделияЗаказчика.Ссылка)
		|			И (ИзделияЗаказчикаПомещения.НомерСтроки = 1)
		|ГДЕ
		|	ИзделияЗаказчика.Проект = &Проект
		|	И НЕ ИзделияЗаказчика.ЭтоГруппа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПомещения,
		|	Наименование";
	
	Запрос.УстановитьПараметр("Проект", Проект);      
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьИзделияЗаказчика() 

Функция ПолучитьДанныеПомещений(Проект, МассивИзделийЗаказчика) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(СостояниеЗамераСрезПоследних.Период) КАК Период,
		|	СостояниеЗамераСрезПоследних.ОбъектЗамера КАК ОбъектЗамера
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.СостояниеЗамера.СрезПоследних(, ОбъектЗамера.Проект = &Проект) КАК СостояниеЗамераСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	СостояниеЗамераСрезПоследних.ОбъектЗамера
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостояниеЗамераСрезПоследних.Период КАК Период,
		|	СостояниеЗамераСрезПоследних.ОбъектЗамера КАК ОбъектЗамера,
		|	СостояниеЗамераСрезПоследних.СтатусЗамера КАК СтатусЗамера
		|ПОМЕСТИТЬ вт1
		|ИЗ
		|	вт КАК вт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеЗамера.СрезПоследних(, ОбъектЗамера.Проект = &Проект) КАК СостояниеЗамераСрезПоследних
		|		ПО вт.Период = СостояниеЗамераСрезПоследних.Период
		|			И вт.ОбъектЗамера = СостояниеЗамераСрезПоследних.ОбъектЗамера
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИзделияЗаказчикаПомещения.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияЗаказчикаПомещения.Помещение КАК Помещение,
		|	ГабаритныеЧертежиПомещения.Ссылка КАК ГЧ,
		|	вт1.Период КАК ПериодГЧ,
		|	вт1.СтатусЗамера КАК СтатусЗамераГЧ,
		|	вт11.СтатусЗамера КАК СтатусЗамераПомещения,
		|	вт11.Период КАК ПериодПомещения,
		|	ГабаритныеЧертежиПомещения.Ссылка.Наименование КАК НаименованиеГЧ,
		|	ИзделияЗаказчикаПомещения.Помещение.Наименование КАК НаименованиеПомещение
		|ИЗ
		|	Справочник.ИзделияЗаказчика.Помещения КАК ИзделияЗаказчикаПомещения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГабаритныеЧертежи.Помещения КАК ГабаритныеЧертежиПомещения
		|			ЛЕВОЕ СОЕДИНЕНИЕ вт1 КАК вт1
		|			ПО ГабаритныеЧертежиПомещения.Ссылка = вт1.ОбъектЗамера
		|		ПО ИзделияЗаказчикаПомещения.Помещение = ГабаритныеЧертежиПомещения.Помещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт1 КАК вт11
		|		ПО ИзделияЗаказчикаПомещения.Помещение = вт11.ОбъектЗамера
		|ГДЕ
		|	ИзделияЗаказчикаПомещения.Ссылка В(&МассивИзделийЗаказчика)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИзделияЗаказчикаПомещения.Ссылка,
		|	ИзделияЗаказчикаПомещения.Помещение,
		|	ГабаритныеЧертежиПомещения.Ссылка,
		|	вт1.Период,
		|	вт1.СтатусЗамера,
		|	вт11.СтатусЗамера,
		|	вт11.Период,
		|	ИзделияЗаказчикаПомещения.Помещение.Наименование,
		|	ГабаритныеЧертежиПомещения.Ссылка.Наименование";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("МассивИзделийЗаказчика", МассивИзделийЗаказчика);
	
	ДанныеПомещенийГЧ = Запрос.Выполнить().Выгрузить();
	
	ОписаниеДата = Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	
	ДанныеПомещенийГЧ.Колонки.Добавить("ДатаЗамер", 			ОписаниеДата);
	ДанныеПомещенийГЧ.Колонки.Добавить("ДатаПомещениеМонтаж", 	ОписаниеДата);
	
	Для каждого х Из ДанныеПомещенийГЧ Цикл
		Если х.СтатусЗамераГЧ = Перечисления.СтатусыЗамера.Рабочий Тогда
			х.ДатаЗамер = х.ПериодГЧ;
		КонецЕсли;
		
		Если х.СтатусЗамераПомещения = Перечисления.СтатусыЗамера.Строительный Тогда
			х.ДатаПомещениеМонтаж = х.ПериодПомещения;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеПомещенийГЧ.Колонки.Удалить("ПериодГЧ");
	ДанныеПомещенийГЧ.Колонки.Удалить("СтатусЗамераГЧ");
	ДанныеПомещенийГЧ.Колонки.Удалить("СтатусЗамераПомещения");
	ДанныеПомещенийГЧ.Колонки.Удалить("ПериодПомещения"); 
	
	Возврат  ДанныеПомещенийГЧ;
	
КонецФункции // ПолучитьДанныеПомещений()

Функция СоздатьФайлОтчета(ПутьКФайлу = "", ПолеВывода = Неопределено, Проекты = Неопределено, ТипФайла = Неопределено) Экспорт

	Если ПолеВывода = Неопределено Тогда
	
		ПолеВывода = Новый ТабличныйДокумент;	
	
	КонецЕсли;
	
	СформироватьОтчетНаСервере(ПолеВывода, Проекты);
	
	Если НЕ ПустаяСтрока(ПутьКФайлу) Тогда
	
		ПолеВывода.Записать(ПутьКФайлу, ?(ТипФайла = Неопределено, ТипФайлаТабличногоДокумента.PDF, ТипФайла));		
	
	КонецЕсли;
	
	
КонецФункции // СоздатьФайлОтчета()

Процедура СформироватьОтчетНаСервере(ПолеВывода, Проекты)
	
	Если Проекты = Неопределено Тогда
		Проекты = Отчеты.СостояниеПроекта.ЗаполнитьПроектыНаСервере(Новый Массив);
	КонецЕсли;
	
	ПолеВывода.Очистить(); 		
	Если Не ЗначениеЗаполнено(Проекты) Тогда
		Возврат;	
	КонецЕсли;
	
	стТаблицы = ПолучитьТаблицуДанных(Проекты);
	
	ВывестиДанные(стТаблицы, ПолеВывода);
	
КонецПроцедуры // СформироватьОтчетНаСервере()

