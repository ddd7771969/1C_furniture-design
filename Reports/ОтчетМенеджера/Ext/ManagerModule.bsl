Функция ПолучитьНаименованияПроектов(СписокВыбора, ПоказатьВсе = Ложь, СписокСПараметрами = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланДатыСрезПоследних.Параметр КАК Параметр,
	|	ПланДатыСрезПоследних.НаименованиеПараметра КАК НаименованиеПараметра
	|ИЗ
	|	РегистрСведений.ПланДаты.СрезПоследних(, Комплект = НЕОПРЕДЕЛЕНО) КАК ПланДатыСрезПоследних
	|ГДЕ
	|	ПланДатыСрезПоследних.Параметр <> ""&&&&""
	|	И ПланДатыСрезПоследних.НаименованиеПараметра ПОДОБНО ""НП#%""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Параметр";
	
	Если ПоказатьВсе Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПланДатыСрезПоследних.Параметр <> """"", "");	
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(?(ПоказатьВсе, Выборка.НаименованиеПараметра, Выборка.Параметр), СтрЗаменить(Выборка.Параметр, "_", " "));
		
		Если НЕ СписокСПараметрами = Неопределено Тогда
			СписокСПараметрами.Добавить(Выборка.НаименованиеПараметра, Выборка.Параметр);	
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ПолучитьНаименованияПроектов()

Функция ПолучитьНомерОтчетаПоНаименованиею(НаименованиеОтчета, СписокСПараметрами) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланДатыСрезПоследних.НаименованиеПараметра КАК НаименованиеПараметра,
	|	ПланДатыСрезПоследних.Параметр КАК Параметр
	|ИЗ
	|	РегистрСведений.ПланДаты.СрезПоследних(, Комплект = НЕОПРЕДЕЛЕНО) КАК ПланДатыСрезПоследних
	|ГДЕ
	|	ПланДатыСрезПоследних.Параметр = &НаименованиеОтчета
	|	И ПланДатыСрезПоследних.НаименованиеПараметра ПОДОБНО ""НП#%""";
	
	
	Запрос.УстановитьПараметр("НаименованиеОтчета", НаименованиеОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	НомерОтчета = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		НомерОтчета = СтрЗаменить(Выборка.НаименованиеПараметра, "НП#", "");
		СписокСПараметрами.Добавить(Выборка.НаименованиеПараметра, Выборка.Параметр);	
	КонецЦикла;
	
	Возврат НомерОтчета;
	
КонецФункции // ПолучитьНомерОтчетаПоНаименованиею() 

Функция ПреробразоватьПараметрКолонкиВСтруктуру(НаименованиеПараметра, СписокСПараметрамиИменаОтчетов) Экспорт
	
	МасиивДанных = СтрРазделить(НаименованиеПараметра, "#");
	
	Если НЕ МасиивДанных.Количество() = 3 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ПараметрОтчета = "НП#" + МасиивДанных[1]; 
	
	НайденоеЗначение = СписокСПараметрамиИменаОтчетов.НайтиПоЗначению(ПараметрОтчета);
	
	Если НайденоеЗначение = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ДанныеКолонки = СтрРазделить(МасиивДанных[2], "?");
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("НаименованиеОтчета", НайденоеЗначение.Представление);
	СтруктураДанных.Вставить("НомерКолонки", Число(ДанныеКолонки[0]));
	СтруктураДанных.Вставить("ТипПараметра", ДанныеКолонки[1]);
	
	Возврат СтруктураДанных;
	
КонецФункции // ПреробразоватьПараметрКолонкиВСтруктуру()

Функция ПреробразоватьПараметрВСтруктуру(НаименованиеПараметра, СписокСПараметрамиИменаОтчетов) Экспорт
	
	МасиивДанных = СтрРазделить(НаименованиеПараметра, "#");
	
	Если НЕ МасиивДанных.Количество() = 2 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ПараметрОтчета = "НП#" + МасиивДанных[1]; 
	
	НайденоеЗначение = СписокСПараметрамиИменаОтчетов.НайтиПоЗначению(ПараметрОтчета);
	
	Если НайденоеЗначение = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если МасиивДанных[0] = "ИК" Тогда
		ТипПараметра = "ИспользоватьКомпозиции";
	ИначеЕсли МасиивДанных[0] = "ОГ" Тогда
		ТипПараметра = "ОсновнаяГруппировка";
    Иначе
		Возврат Неопределено;	
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("НаименованиеОтчета", 	НайденоеЗначение.Представление);
	СтруктураДанных.Вставить("ТипПараметра", 		ТипПараметра);
	
	Возврат СтруктураДанных;
	
КонецФункции // ПреробразоватьПараметрКолонкиВСтруктуру()

Функция ПолучитьКолонкиОтчета(НаименованиеОтчета) Экспорт
	
	СписокСПараметрамиИменаОтчетов = Новый СписокЗначений;
	
	НомерОтчета = ПолучитьНомерОтчетаПоНаименованиею(НаименованиеОтчета, СписокСПараметрамиИменаОтчетов);
	
	Если НомерОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	КолонкиОтчета = Новый ТаблицаЗначений;
	КолонкиОтчета.Колонки.Добавить("НомерКолонки");	
	КолонкиОтчета.Колонки.Добавить("ТипРасчетногоЗначения");	
	КолонкиОтчета.Колонки.Добавить("НаименованиеКолонки");	
	КолонкиОтчета.Колонки.Добавить("ТипКолонки");	
	КолонкиОтчета.Колонки.Добавить("Сортировка");	
	КолонкиОтчета.Колонки.Добавить("ПоказыватьРучныеЗначения");	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланДатыСрезПоследних.Параметр КАК Параметр,
	|	ПланДатыСрезПоследних.НаименованиеПараметра КАК НаименованиеПараметра,
	|	ПланДатыСрезПоследних.ТипКолонки КАК ТипКолонки,
	|	ПланДатыСрезПоследних.ТипРасчетныхЗначений КАК ТипРасчетныхЗначений,
	|	ПланДатыСрезПоследних.ТипРасчетныхЗначений.ТипКолонки КАК ТипРасчетныхЗначенийТипКолонки
	|ИЗ
	|	РегистрСведений.ПланДаты.СрезПоследних КАК ПланДатыСрезПоследних
	|ГДЕ
	|	ПланДатыСрезПоследних.Комплект = НЕОПРЕДЕЛЕНО
	|	И ПланДатыСрезПоследних.Параметр <> ""&&&&""
	|	И ПланДатыСрезПоследних.НаименованиеПараметра ПОДОБНО &ПрефиксКолонки";
	
	Запрос.УстановитьПараметр("ПрефиксКолонки", "НК#" + НомерОтчета + "#%");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отбор = Новый Структура("НомерКолонки", );
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = ПреробразоватьПараметрКолонкиВСтруктуру(Выборка.НаименованиеПараметра, СписокСПараметрамиИменаОтчетов);
		
		Если СтруктураДанных = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		Отбор.НомерКолонки = СтруктураДанных.НомерКолонки;
		НайденыеСтроки = КолонкиОтчета.НайтиСтроки(Отбор);
		
		Если НайденыеСтроки.Количество() = 0 Тогда
			НС = КолонкиОтчета.Добавить();
			НС.НомерКолонки = Отбор.НомерКолонки;
		Иначе
			НС = НайденыеСтроки[0];
		КонецЕсли;
		
		Если СтруктураДанных.ТипПараметра = "Н" Тогда
			НС.НаименованиеКолонки = Выборка.Параметр;
			НС.ТипКолонки = Выборка.ТипКолонки;
			НС.ТипРасчетногоЗначения = Выборка.ТипРасчетныхЗначений;
			НС.ТипКолонки = ?(ЗначениеЗаполнено(Выборка.ТипРасчетныхЗначений), Выборка.ТипРасчетныхЗначенийТипКолонки, Выборка.ТипКолонки);
		ИначеЕсли СтруктураДанных.ТипПараметра = "Сор" Тогда
			НС.Сортировка = Выборка.Параметр;
		ИначеЕсли СтруктураДанных.ТипПараметра = "РЗ" Тогда
			НС.ПоказыватьРучныеЗначения = Выборка.Параметр;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КолонкиОтчета;	
	
КонецФункции // ПолучитьКолонкиОтчета()

Функция ПолучитьКомплектыПроекта(Проект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияКомплект.Ссылка КАК Комплект,
		|	ИзделияКомплект.Наименование КАК Наименование,
		|	ИзделияКомплект.ГабаритныйЧертеж КАК ГабаритныйЧертеж,
		|	ИзделияКомплект.Родитель.Композиция КАК РодительКомпозиция,
		|	ИзделияКомплект.ОсновноеПомещение КАК ОсновноеПомещение,
		|	ИзделияКомплект.Родитель.Композиция.ОсновноеПомещение КАК РодительКомпозицияОсновноеПомещение,
		|	ИзделияКомплект.Родитель.Композиция.ГабаритныйЧертеж КАК РодительКомпозицияГабаритныйЧертеж,
		|	ИзделияКомплект.ОсновноеПомещение.НомерПомещения КАК ОсновноеПомещениеНомерПомещения,
		|	ИзделияКомплект.Родитель.ОсновноеПомещение.НомерПомещения КАК РодительОсновноеПомещениеНомерПомещения
		|ИЗ
		|	Справочник.ИзделияКомплект КАК ИзделияКомплект
		|ГДЕ
		|	ИзделияКомплект.Проект = &Проект";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Возврат ПолучитьПродолжительностьПериодов(Запрос.Выполнить().Выгрузить(), Проект);
	
КонецФункции // ПолучитьКомплектыПроекта()

Функция ПолучитьПродолжительностьПериодов(ТаблицаПроекты, Проект) Экспорт
	
	ОписаниеЧисло 	= Новый ОписаниеТипов("Число");
	ОписаниеДата 	= Новый ОписаниеТипов("Дата");
	
	ТаблицаПроекты.Колонки.Добавить("СрокМонтажаВНеделях", 				ОписаниеЧисло);				
	ТаблицаПроекты.Колонки.Добавить("СрокПроектированияВНеделях", 		ОписаниеЧисло);				
	ТаблицаПроекты.Колонки.Добавить("СрокПроизводстваВНеделях", 		ОписаниеЧисло);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияМонтажаРасчет", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияПроизводстваРасчет",	ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияМонтажа", 			ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияПКД", 				ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаОкончанияПроизводства", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("ДатаСогласованияАрхитектором", 	ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомплектДатаОтказа", 				ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомплектДатаСогласования", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомплектДатаОтправки", 			ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомпозицияДатаОтказа", 			ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомпозицияДатаСогласования", 		ОписаниеДата);				
	ТаблицаПроекты.Колонки.Добавить("КомпозицияДатаОтправки", 			ОписаниеДата);				
	ТаблицаПроекты.Индексы.Добавить("Комплект");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СрокиПоДоговору.ИзделиеЗаказчика КАК ИзделиеЗаказчика,
		|	ИзделияКомплектИзделияЭлемент.Ссылка КАК Комплект,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция КАК Композиция,
		|	СрокиПоДоговору.СрокМонтажаВНеделях КАК СрокМонтажаВНеделях,
		|	СрокиПоДоговору.СрокПроектированияВНеделях КАК СрокПроектированияВНеделях,
		|	СрокиПоДоговору.СрокПроизводстваВНеделях КАК СрокПроизводстваВНеделях,
		|	СрокиПоДоговору.ДатаОкончанияМонтажа КАК ДатаОкончанияМонтажа,
		|	СрокиПоДоговору.ДатаОкончанияПКД КАК ДатаОкончанияПКД,
		|	СрокиПоДоговору.ДатаОкончанияПроизводства КАК ДатаОкончанияПроизводства
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.СрокиПоДоговору КАК СрокиПоДоговору
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИзделияЗаказчика.ИзделияЭлемент КАК ИзделияЗаказчикаИзделияЭлемент
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИзделияКомплект.ИзделияЭлемент КАК ИзделияКомплектИзделияЭлемент
		|			ПО (ИзделияКомплектИзделияЭлемент.ИзделиеЭлемент = ИзделияЗаказчикаИзделияЭлемент.ИзделиеЭлемент)
		|		ПО СрокиПоДоговору.ИзделиеЗаказчика = ИзделияЗаказчикаИзделияЭлемент.Ссылка
		|ГДЕ
		|	ИзделияКомплектИзделияЭлемент.Ссылка В(&мКомплекты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором,
		|	ДатыСогласования.Комплект КАК Комплект
		|ПОМЕСТИТЬ втДатыСогласованияКомплекты
		|ИЗ
		|	РегистрСведений.ДатыСогласования КАК ДатыСогласования
		|ГДЕ
		|	ДатыСогласования.Комплект В(&мКомплекты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором,
		|	ДатыСогласования.Комплект КАК Композиция
		|ПОМЕСТИТЬ втДатыСогласованияКомпозиции
		|ИЗ
		|	РегистрСведений.ДатыСогласования КАК ДатыСогласования
		|ГДЕ
		|	ДатыСогласования.Комплект В(&мКомпозиция)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВнешниеСогласованияЧертежейСрезПоследних.Комплект КАК Комплект,
		|	ВнешниеСогласованияЧертежейСрезПоследних.ДатаОтказа КАК ДатаОтказа,
		|	ВнешниеСогласованияЧертежейСрезПоследних.ДатаОтправки КАК ДатаОтправки,
		|	ВнешниеСогласованияЧертежейСрезПоследних.ДатаСогласования КАК ДатаСогласования
		|ПОМЕСТИТЬ втСогласованиеСЗакзачиком
		|ИЗ
		|	РегистрСведений.ВнешниеСогласованияЧертежей.СрезПоследних(, Комплект.Проект = &Проект) КАК ВнешниеСогласованияЧертежейСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(вт.СрокМонтажаВНеделях) КАК СрокМонтажаВНеделях,
		|	МИНИМУМ(вт.СрокПроектированияВНеделях) КАК СрокПроектированияВНеделях,
		|	МИНИМУМ(вт.СрокПроизводстваВНеделях) КАК СрокПроизводстваВНеделях,
		|	вт.Комплект КАК Комплект,
		|	вт.ДатаОкончанияМонтажа КАК ДатаОкончанияМонтажа,
		|	вт.ДатаОкончанияПКД КАК ДатаОкончанияПКД,
		|	вт.ДатаОкончанияПроизводства КАК ДатаОкончанияПроизводства,
		|	втДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором,
		|	вт.Композиция КАК Композиция,
		|	втДатыСогласованияКомпозиции.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитекторомКопозиция,
		|	втСогласованиеСЗакзачиком.ДатаОтказа КАК КомплектДатаОтказа,
		|	втСогласованиеСЗакзачиком.ДатаОтправки КАК КомплектДатаОтправки,
		|	втСогласованиеСЗакзачиком.ДатаСогласования КАК КомплектДатаСогласования,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтказа КАК КомпозицияДатаОтказа,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтправки КАК КомпозицияДатаОтправки,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаСогласования КАК КомпозицияДатаСогласования
		|ИЗ
		|	вт КАК вт
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДатыСогласованияКомплекты КАК втДатыСогласования
		|		ПО вт.Комплект = втДатыСогласования.Комплект
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДатыСогласованияКомпозиции КАК втДатыСогласованияКомпозиции
		|		ПО вт.Композиция = втДатыСогласованияКомпозиции.Композиция
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСогласованиеСЗакзачиком КАК втСогласованиеСЗакзачиком
		|		ПО (вт.Комплект = (ВЫРАЗИТЬ(втСогласованиеСЗакзачиком.Комплект КАК Справочник.ИзделияКомплект)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСогласованиеСЗакзачиком КАК втСогласованиеСЗакзачикомКомпозиции
		|		ПО (вт.Композиция = (ВЫРАЗИТЬ(втСогласованиеСЗакзачикомКомпозиции.Комплект КАК Справочник.Композиции)))
		|
		|СГРУППИРОВАТЬ ПО
		|	вт.Комплект,
		|	вт.ДатаОкончанияМонтажа,
		|	вт.ДатаОкончанияПКД,
		|	вт.ДатаОкончанияПроизводства,
		|	втДатыСогласования.ДатаСогласованияАрхитектором,
		|	вт.Композиция,
		|	втДатыСогласованияКомпозиции.ДатаСогласованияАрхитектором,
		|	втСогласованиеСЗакзачиком.ДатаОтказа,
		|	втСогласованиеСЗакзачиком.ДатаОтправки,
		|	втСогласованиеСЗакзачиком.ДатаСогласования,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтказа,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаОтправки,
		|	втСогласованиеСЗакзачикомКомпозиции.ДатаСогласования";
	
	Запрос.УстановитьПараметр("мКомплекты", 	ТаблицаПроекты.ВыгрузитьКолонку("Комплект"));
	Запрос.УстановитьПараметр("мКомпозиция", 	ТаблицаПроекты.ВыгрузитьКолонку("Композиция"));
	Запрос.УстановитьПараметр("Проект", 		Проект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденаяСтрока = ТаблицаПроекты.Найти(Выборка.Комплект, "Комплект");	
		ЗаполнитьЗначенияСвойств(НайденаяСтрока, Выборка);
		
	КонецЦикла;
	
	ЗаполнитьРасчетныеЗначения(ТаблицаПроекты);
	
	Возврат ТаблицаПроекты;
	
КонецФункции 

Процедура ЗаполнитьРасчетныеЗначения(ТаблицаПроекты)

	ТД 				= НачалоДня(ТекущаяДатаСеанса());
	ГЧПринят 		= Перечисления.СтатусыЗамера.Рабочий;
	СекундВНеделе 	= 7 * 24 * 3600;
	
	Для каждого х Из ТаблицаПроекты Цикл
	
		Если х.КомплектСтатусЗамера = ГЧПринят И ЗначениеЗаполнено(х.КомплектДатаСогласования) Тогда
			КомплектДатаСогласования = х.КомплектДатаСогласования;
		Иначе
			КомплектДатаСогласования = ТД;
		КонецЕсли;
		
		Если х.КомплектСтатусЗамераПомещения = ГЧПринят И ЗначениеЗаполнено(х.КомплектДатаПомещения) Тогда
			КомплектДатаПомещения = х.КомплектДатаПомещения;
		Иначе
			КомплектДатаПомещения = ТД;
		КонецЕсли;
		
		Если х.КомпозицияСтатусЗамера = ГЧПринят И ЗначениеЗаполнено(х.КомпозицияДатаГЧ) Тогда
			КомпозицияДатаГЧ = х.КомпозицияДатаГЧ;
		Иначе
			КомпозицияДатаГЧ = ТД;
		КонецЕсли;
		Если х.КомпозицияСтатусЗамераПомещения = ГЧПринят И ЗначениеЗаполнено(х.КомпозицияДатаПомещения) Тогда
			КомпозицияДатаПомещения = х.КомпозицияДатаПомещения;
		Иначе
			КомпозицияДатаПомещения = ТД;
		КонецЕсли; 
		
		
		х.ДатаОкончанияПроизводстваРасчет   	= КомплектДатаСогласования + СекундВНеделе * х.СрокМонтажаВНеделях;
		
		ДатаОкончанияПроизводстваРасчет 	= Макс(х.ДатаОкончанияПроизводстваРасчет, КомпозицияДатаПомещения);
		х.ДатаОкончанияМонтажаРасчет 		= ДатаОкончанияПроизводстваРасчет + СекундВНеделе * х.СрокМонтажаВНеделях
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьКомплектыИзделияПомещенияПроекта(Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостояниеГЧСрезПоследних.ОбъектЗамера КАК ОбъектЗамера,
		|	СостояниеГЧСрезПоследних.СтатусЗамера КАК СтатусЗамера,
		|	СостояниеГЧСрезПоследних.Период КАК Период
		|ПОМЕСТИТЬ втСтатусГЧ
		|ИЗ
		|	РегистрСведений.СостояниеЗамера.СрезПоследних(, ОбъектЗамера.Проект = &Проект) КАК СостояниеГЧСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Наименование КАК КомплектНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка КАК Комплект,
		|	втСтатусГЧ.СтатусЗамера КАК КомплектСтатусЗамера,
		|	втСтатусГЧ.Период КАК ДатаГЧ,
		|	втСтатусГЧ2.СтатусЗамера КАК КомплектСтатусЗамераПомещения,
		|	втСтатусГЧ2.Период КАК КомплектДатаПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ОсновноеПомещение КАК ОсновноеПомещениеКомплекта,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ОсновноеПомещение.НомерПомещения КАК КомплектОсновноеПомещениеНомерПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж КАК КомплектГабаритныйЧертеж,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж.Наименование КАК КомплектГабаритныйЧертежНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.Ссылка КАК Композиция,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.Наименование КАК КомпозицияНаименование,
		|	втСтатусГЧ1.СтатусЗамера КАК КомпозицияСтатусЗамера,
		|	втСтатусГЧ3.СтатусЗамера КАК КомпозицияСтатусЗамераПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение КАК КомпозицияОсновноеПомещение,
		|	втСтатусГЧ1.Период КАК КомпозицияДатаГЧ,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение.Наименование КАК КомпозицияОсновноеПомещениеНаименование,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение.НомерПомещения КАК КомпозицияОсновноеПомещениеНомерПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж КАК КомпозицияГабаритныйЧертеж,
		|	втСтатусГЧ3.Период КАК КомпозицияДатаПомещения,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж.Наименование КАК КомпозицияГабаритныйЧертежНаименование,
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка.Наименование КАК ИзделиеЗаказчикаНаименование,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК СостояниеЧертежей
		|ИЗ
		|	Справочник.ИзделияКомплект.ИзделияЭлемент КАК ИзделияКомплектИзделияЭлемент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИзделияЗаказчика.ИзделияЭлемент КАК ИзделияЗаказчикаИзделияЭлемент
		|		ПО ИзделияКомплектИзделияЭлемент.ИзделиеЭлемент = ИзделияЗаказчикаИзделияЭлемент.ИзделиеЭлемент
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж = (ВЫРАЗИТЬ(втСтатусГЧ.ОбъектЗамера КАК Справочник.ГабаритныеЧертежи)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ1
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ГабаритныйЧертеж = (ВЫРАЗИТЬ(втСтатусГЧ1.ОбъектЗамера КАК Справочник.ГабаритныеЧертежи)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ2
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.ГабаритныйЧертеж = (ВЫРАЗИТЬ(втСтатусГЧ1.ОбъектЗамера КАК Справочник.Помещения)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСтатусГЧ КАК втСтатусГЧ3
		|		ПО (ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция.ОсновноеПомещение = (ВЫРАЗИТЬ(втСтатусГЧ1.ОбъектЗамера КАК Справочник.Помещения)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|		ПО ИзделияКомплектИзделияЭлемент.Ссылка = ДанныеКомплектаСрезПоследних.Комплект
		|ГДЕ
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Проект = &Проект";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Возврат ПолучитьПродолжительностьПериодов(Запрос.Выполнить().Выгрузить(), Проект);
	
КонецФункции // ПолучитьПомещенияПроекта()

Функция ПолучитьСводнуюТаблицу(ОбластьВывода, Проект) Экспорт

	ОбластьВывода.Очистить();
	
	ТаблицаИзделияЗаказчика = ПолучитьИзделияЗаказчика(Проект);
	МасиивИзделийЗаказчика 	= ТаблицаИзделияЗаказчика.ВыгрузитьКолонку("ИзделиеЗаказчика");
	ТаблицаПомещений 		= ПолучитьДанныеПомещений(МасиивИзделийЗаказчика, Проект);
	ТаблицаСоответствий		= ПолучитьТаблицуСоответствий(МасиивИзделийЗаказчика);
	ТаблицаСогасований 		= ПолучитьДанныеСогласования(ТаблицаСоответствий); 
	
	ОписаниеСтрока 	= Новый ОписаниеТипов("Строка");
