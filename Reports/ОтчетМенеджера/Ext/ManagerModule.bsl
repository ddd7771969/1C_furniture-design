Функция ПолучитьДанныеСогласования(ТаблицаСоответствий)

	МассивКомплект = Новый Массив;
	
	Для каждого х Из ТаблицаСоответствий Цикл
	
		Если ЗначениеЗаполнено(х.Комплект) Тогда
		
			Если ЗначениеЗаполнено(х.Композиция) Тогда
				Если МассивКомплект.Найти(х.Композиция) = Неопределено Тогда
					МассивКомплект.Добавить(х.Композиция);	
				КонецЕсли;	
			Иначе
				Если МассивКомплект.Найти(х.Комплект) = Неопределено Тогда
					МассивКомплект.Добавить(х.Комплект);	
				КонецЕсли;	
			КонецЕсли;	
		
		КонецЕсли;	
	
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнешниеСогласованияЧертежей.Комплект КАК Комплект,
		|	ВнешниеСогласованияЧертежей.ДатаОтказа КАК ДатаОтказа,
		|	ВнешниеСогласованияЧертежей.ДатаОтправки КАК ДатаОтправки,
		|	ВнешниеСогласованияЧертежей.ДатаСогласования КАК ДатаСогласования,
		|	ВнешниеСогласованияЧертежей.Период КАК Период
		|ИЗ
		|	РегистрСведений.ВнешниеСогласованияЧертежей КАК ВнешниеСогласованияЧертежей
		|ГДЕ
		|	ВнешниеСогласованияЧертежей.Комплект В(&Комплект)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыСогласования.Комплект КАК Комплект,
		|	ДатыСогласования.ДатаСогласованияАрхитектором КАК ДатаСогласованияАрхитектором
		|ИЗ
		|	РегистрСведений.ДатыСогласования КАК ДатыСогласования
		|ГДЕ
		|	ДатыСогласования.Комплект В(&Комплект)
		|	И ДатыСогласования.ДатаСогласованияАрхитектором > ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("Комплект", МассивКомплект);
	
	Результат = Запрос.ВыполнитьПакет();
	СогласованиеЗаказчиком 		= Результат[0].Выгрузить();
	СогласованиеАрхитектором 	= Результат[1].Выгрузить();
	
	Возврат Новый Структура("СогласованиеЗаказчиком, СогласованиеАрхитектором", СогласованиеЗаказчиком, СогласованиеАрхитектором); 
	
КонецФункции // ПолучитьДанныеСогласования(ТаблицаСоответствий)

Функция ПолучитьТаблицуСоответствий(МасиивИзделийЗаказчика)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияКомплектИзделияЭлемент.Ссылка КАК Комплект,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция КАК Композиция,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадияПолноеНаименованиеКомплект,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия КАК ТекущаяСтадияКомплект,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия КАК ТекущаяСтадияКомпозиция,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия.ПолноеНаименование КАК ТекущаяСтадияПолноеНаименованиеКомпозиция
		|ИЗ
		|	Справочник.ИзделияЗаказчика.ИзделияЭлемент КАК ИзделияЗаказчикаИзделияЭлемент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИзделияКомплект.ИзделияЭлемент КАК ИзделияКомплектИзделияЭлемент
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|			ПО ИзделияКомплектИзделияЭлемент.Ссылка = ДанныеКомплектаСрезПоследних.Комплект
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних1
		|			ПО ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция = ДанныеКомплектаСрезПоследних1.Комплект
		|		ПО ИзделияЗаказчикаИзделияЭлемент.ИзделиеЭлемент = ИзделияКомплектИзделияЭлемент.ИзделиеЭлемент
		|ГДЕ
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка В(&Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИзделияКомплектИзделияЭлемент.Ссылка,
		|	ИзделияЗаказчикаИзделияЭлемент.Ссылка,
		|	ИзделияКомплектИзделияЭлемент.Ссылка.Родитель.Композиция,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия.ПолноеНаименование,
		|	ДанныеКомплектаСрезПоследних.ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия,
		|	ДанныеКомплектаСрезПоследних1.ТекущаяСтадия.ПолноеНаименование";
	
	Запрос.УстановитьПараметр("Ссылка", МасиивИзделийЗаказчика);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьТаблицуСоответствий()

Функция ПолучитьИзделияЗаказчика(Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзделияЗаказчика.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияЗаказчика.Описание КАК Описание,
		|	ИзделияЗаказчика.РазмерПоТЗ КАК РазмерПоТЗ,
		|	ИзделияЗаказчика.Наименование КАК Наименование,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокМонтажаВНеделях, 0) КАК СрокМонтажа,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокПроектированияВНеделях, 0) КАК СрокПроектирования,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокПроизводстваВНеделях, 0) КАК СрокПроизводства,
		|	ЕСТЬNULL(СрокиПоДоговору.СрокМонтажаВНеделях, 0) + ЕСТЬNULL(СрокиПоДоговору.СрокПроизводстваВНеделях, 0) + ЕСТЬNULL(СрокиПоДоговору.СрокПроектированияВНеделях, 0) КАК СрокДоговора,
		|	ЕСТЬNULL(СрокиПоДоговору.ДатаОкончанияМонтажа, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаМонтажа,
		|	ЕСТЬNULL(СрокиПоДоговору.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
		|	ЕСТЬNULL(СрокиПоДоговору.ДатаОкончанияПроизводства, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПроизводства,
		|	ИзделияЗаказчикаПомещения.Помещение.Наименование КАК ОсновноеПомещение,
		|	ИзделияЗаказчикаПомещения.Помещение.НомерПомещения КАК НомерПомещения
		|ИЗ
		|	Справочник.ИзделияЗаказчика КАК ИзделияЗаказчика
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиПоДоговору КАК СрокиПоДоговору
		|		ПО (СрокиПоДоговору.ИзделиеЗаказчика = ИзделияЗаказчика.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИзделияЗаказчика.Помещения КАК ИзделияЗаказчикаПомещения
		|		ПО (ИзделияЗаказчикаПомещения.Ссылка = ИзделияЗаказчика.Ссылка)
		|			И (ИзделияЗаказчикаПомещения.НомерСтроки = 1)
		|ГДЕ
		|	ИзделияЗаказчика.Проект = &Проект
		|	И НЕ ИзделияЗаказчика.ЭтоГруппа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПомещения,
		|	Наименование";
	
	Запрос.УстановитьПараметр("Проект", Проект);      
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьИзделияЗаказчика() 

Функция ПолучитьДанныеПомещений(МасиивИзделийЗаказчика, Проект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(СостояниеЗамераСрезПоследних.Период) КАК Период,
		|	СостояниеЗамераСрезПоследних.ОбъектЗамера КАК ОбъектЗамера
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.СостояниеЗамера.СрезПоследних(, ОбъектЗамера.Проект = &Проект) КАК СостояниеЗамераСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	СостояниеЗамераСрезПоследних.ОбъектЗамера
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостояниеЗамераСрезПоследних.Период КАК Период,
		|	СостояниеЗамераСрезПоследних.ОбъектЗамера КАК ОбъектЗамера,
		|	СостояниеЗамераСрезПоследних.СтатусЗамера КАК СтатусЗамера
		|ПОМЕСТИТЬ вт1
		|ИЗ
		|	вт КАК вт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеЗамера.СрезПоследних(, ОбъектЗамера.Проект = &Проект) КАК СостояниеЗамераСрезПоследних
		|		ПО вт.Период = СостояниеЗамераСрезПоследних.Период
		|			И вт.ОбъектЗамера = СостояниеЗамераСрезПоследних.ОбъектЗамера
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИзделияЗаказчикаПомещения.Ссылка КАК ИзделиеЗаказчика,
		|	ИзделияЗаказчикаПомещения.Помещение КАК Помещение,
		|	ГабаритныеЧертежиПомещения.Ссылка КАК ГЧ,
		|	вт1.Период КАК ПериодГЧ,
		|	вт1.СтатусЗамера КАК СтатусЗамераГЧ,
		|	вт11.СтатусЗамера КАК СтатусЗамераПомещения,
		|	вт11.Период КАК ПериодПомещения
		|ИЗ
		|	Справочник.ИзделияЗаказчика.Помещения КАК ИзделияЗаказчикаПомещения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГабаритныеЧертежи.Помещения КАК ГабаритныеЧертежиПомещения
		|			ЛЕВОЕ СОЕДИНЕНИЕ вт1 КАК вт1
		|			ПО ГабаритныеЧертежиПомещения.Ссылка = вт1.ОбъектЗамера
		|		ПО ИзделияЗаказчикаПомещения.Помещение = ГабаритныеЧертежиПомещения.Помещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт1 КАК вт11
		|		ПО ИзделияЗаказчикаПомещения.Помещение = вт11.ОбъектЗамера
		|ГДЕ
		|	ИзделияЗаказчикаПомещения.Ссылка В(&ИзделияЗаказчика)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИзделияЗаказчикаПомещения.Ссылка,
		|	ИзделияЗаказчикаПомещения.Помещение,
		|	ГабаритныеЧертежиПомещения.Ссылка,
		|	вт1.Период,
		|	вт1.СтатусЗамера,
		|	вт11.СтатусЗамера,
		|	вт11.Период";
	
	Запрос.УстановитьПараметр("ИзделияЗаказчика", МасиивИзделийЗаказчика);
	Запрос.УстановитьПараметр("Проект", Проект);
	
	ДанныеПомещенийГЧ = Запрос.Выполнить().Выгрузить();
	
	ОписаниеДата = Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	
	ДанныеПомещенийГЧ.Колонки.Добавить("ДатаЗамер", 			ОписаниеДата);
	ДанныеПомещенийГЧ.Колонки.Добавить("ДатаПомещениеМонтаж", 	ОписаниеДата);
	
	Для каждого х Из ДанныеПомещенийГЧ Цикл
		Если х.СтатусЗамераГЧ = Перечисления.СтатусыЗамера.Рабочий Тогда
			х.ДатаЗамер = х.ПериодГЧ;
		КонецЕсли;
		
		Если х.СтатусЗамераПомещения = Перечисления.СтатусыЗамера.Строительный Тогда
			х.ДатаПомещениеМонтаж = х.ПериодПомещения;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеПомещенийГЧ.Колонки.Удалить("ПериодГЧ");
	ДанныеПомещенийГЧ.Колонки.Удалить("СтатусЗамераГЧ");
	ДанныеПомещенийГЧ.Колонки.Удалить("СтатусЗамераПомещения");
	ДанныеПомещенийГЧ.Колонки.Удалить("ПериодПомещения"); 
	
	Возврат  ДанныеПомещенийГЧ;
	
КонецФункции // ПолучитьДанныеПомещений()

