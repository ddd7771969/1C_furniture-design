	//ТзИзделияЗаказчиков.Колонки.Добавить("СрокПроизводства", ОписаниеЧисло);
	//ТзИзделияЗаказчиков.Колонки.Добавить("СрокМонтажа", ОписаниеЧисло);
	//ТзИзделияЗаказчиков.Колонки.Добавить("СрокДоговора", ОписаниеЧисло);
