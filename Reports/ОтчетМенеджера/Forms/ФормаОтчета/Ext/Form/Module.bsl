
&НаКлиенте
Процедура Настройки(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОкнаНастроек", ЭтотОбъект);
	ОткрытьФорму("Отчет.ОтчетМенеджера.Форма.ФормаНастройкиОтчета", , ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗакрытияОкнаНастроек(Результат, ДополнительныеПараметры) Экспорт
	Обновить(Неопределено);
КонецПроцедуры // ПослеЗакрытияОкнаНастроек()

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Отчеты.ОтчетМенеджера.ПолучитьНаименованияПроектов(Элементы.НаименованиеОтчета.СписокВыбора);
КонецПроцедуры

Процедура ОбновитьНаСервере()
	
	 Отчеты.ОтчетМенеджера.ПолучитьСводнуюТаблицу(ПолеОтчета, Проект); 
	 
КонецПроцедуры 

Функция ПолучитьИзделия(НайденыеСтроки)

	Изделия = "";
	
	Для каждого х Из НайденыеСтроки Цикл
	
		Изделия = Изделия + ?(ПустаяСтрока(Изделия), "", ", ") + х.ИзделиеЗаказчикаНаименование;
	
	КонецЦикла;
	
	Возврат Изделия;

КонецФункции // ПолучитьИзделия()

Функция ПолучитКолонкиОтчета(НаименованиеОтчета)

	ДаннеОКолонках = Отчеты.ОтчетМенеджера.ПолучитьКолонкиОтчета(НаименованиеОтчета);	

КонецФункции // ПолучитКолонкиОтчета(НаименованиеОтчета)

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеОтчетаПриИзменении(Элемент)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	ОбновитьНаСервере();
КонецПроцедуры
