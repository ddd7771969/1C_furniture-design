
&НаКлиенте
Процедура Настройки(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОкнаНастроек", ЭтотОбъект);
	ОткрытьФорму("Отчет.ОтчетМенеджера.Форма.ФормаНастройкиОтчета", , ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗакрытияОкнаНастроек(Результат, ДополнительныеПараметры) Экспорт
	Обновить(Неопределено);
КонецПроцедуры // ПослеЗакрытияОкнаНастроек()


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Отчеты.ОтчетМенеджера.ПолучитьНаименованияПроектов(Элементы.НаименованиеОтчета.СписокВыбора);
КонецПроцедуры


&НаСервере
Процедура ОбновитьНаСервере()
	
	ПолеОтчета.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Проект) Тогда
		Возврат;	
	КонецЕсли;
	//Если НЕ (ЗначениеЗаполнено(НаименованиеОтчета) И ЗначениеЗаполнено(Проект)) Тогда
	//	Возврат;	
	//КонецЕсли;
	//
	//
	//КолонкиОтчета = ПолучитКолонкиОтчета(НаименованиеОтчета);
	
	ТаблицаДанных = Отчеты.ОтчетМенеджера.ПолучитьКомплектыИзделияПомещенияПроекта(Проект);
	
	Макет = отчеты.ОтчетМенеджера.ПолучитьМакет("Макет");
	
	ПолеОтчета.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	Область = Макет.ПолучитьОбласть("Строка");
	Номер = 1;
	
	ТаблицаДанных.Сортировать("КомплектОсновноеПомещениеНомерПомещения, КомплектНаименование");
	
	мКомплекты = Новый Массив;
	
	Для каждого х Из ТаблицаДанных Цикл
	
		Если мКомплекты.Найти(х.Комплект) = Неопределено Тогда
		
			мКомплекты.Добавить(х.Комплект);	
		
		КонецЕсли;	
	
	КонецЦикла;
	
	Отбор = Новый Структура("Комплект", );
	
	Для каждого Комплект Из мКомплекты Цикл
		
		Отбор.Комплект = Комплект;
		НайденыеСтроки = ТаблицаДанных.НайтиСтроки(Отбор);
		
		текСтрока = НайденыеСтроки[0];
		
		Область.Параметры.Заполнить(текСтрока);
		
		Область.Параметры.Изделие = ПолучитьИзделия(НайденыеСтроки);
		
		Область.Параметры.Комплект = Комплект;
		Область.Параметры.Комплект = Комплект;
		Область.Параметры.Комплект = Комплект;
		Область.Параметры.Комплект = Комплект;
		
		Область.Параметры.Номер = Номер;
		ПолеОтчета.Вывести(Область);
		
		Номер = Номер + 1;
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьИзделия(НайденыеСтроки)

	Изделия = "";
	
	Для каждого х Из НайденыеСтроки Цикл
	
		Изделия = Изделия + ?(ПустаяСтрока(Изделия), "", ", ") + х.ИзделиеЗаказчикаНаименование;
	
	КонецЦикла;
	
	Возврат Изделия;

КонецФункции // ПолучитьИзделия()


Функция ПолучитКолонкиОтчета(НаименованиеОтчета)

	ДаннеОКолонках = Отчеты.ОтчетМенеджера.ПолучитьКолонкиОтчета(НаименованиеОтчета);	

КонецФункции // ПолучитКолонкиОтчета(НаименованиеОтчета)


&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеОтчетаПриИзменении(Элемент)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	ОбновитьНаСервере();
КонецПроцедуры
