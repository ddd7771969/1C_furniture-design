&НаКлиенте
Процедура НормаВремени_ПКДРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Объект.ПланРазработкиВДнях = Объект.ПланРазработкиВДнях + Направление * 0.5;
	
	Если Объект.ПланРазработкиВДнях = 0 Тогда
		Объект.ПланРазработкиВДнях = 0.5;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомплектыПриИзменении(Элемент)
	
	ВремяРазработки = Новый Соответствие();
	
	
	Для каждого ТекущийКомплект Из Объект.Комплекты Цикл
		
		НайденКонструктор = Ложь;
		
		Для каждого х Из ВремяРазработки Цикл
		
			Если ТекущийКомплект.Конструктор = х.Ключ Тогда
				ВремяРазработки[х.Ключ]	= х.Значение + ТекущийКомплект.ПланРазработкиВДнях;
				НайденКонструктор 		= Истина;
			КонецЕсли;	
		
		КонецЦикла;
		
		Если НЕ НайденКонструктор Тогда
		
			ВремяРазработки.Вставить(ТекущийКомплект.Конструктор, ТекущийКомплект.ПланРазработкиВДнях);	
		
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ПланРазработкиВДнях = 0;
	
	Для каждого х Из ВремяРазработки Цикл
		
		Если Объект.ПланРазработкиВДнях < х.Значение Тогда
			Объект.ПланРазработкиВДнях = х.Значение;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

