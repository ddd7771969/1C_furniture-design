
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Объект.ОбъектТЗ) Тогда
	
		Элементы.Проект.ТолькоПросмотр 				= Истина;	
		Элементы.ГабаритныйЧертеж.ТолькоПросмотр 	= Истина;	
	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.НовыйСтатус) Тогда
	
		Элементы.НовыйСтатус.Видимость	= Ложь;	
	
	КонецЕсли;
	
	ОформлениеФормы(); 
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МаксимальноеКоличествоЗадачСоздание = омЗадачиПКДПовтор.ПолучитьКоличествоЗадачСозданиеЗамеров();  
	
	Элементы.ДекорацияВыполнен.Видимость 	= Объект.Выполнена;
	Элементы.ДекорацияНеВыполнен.Видимость 	= НЕ Элементы.ДекорацияВыполнен.Видимость;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ИсполнительПриИзмененииНаСервере(Исполнитель)
	Возврат Задачи.ПроверитьГабаритныеЧертежи.КоличествоЗапущеныхЗадач(Исполнитель);  
КонецФункции

&НаКлиенте
Процедура Сохранить_и_Закрыть(Команда)
	Записать();
	Оповестить("ИзменениеЗамеров");
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВыполнениеНаСервере()

	ЗадачаОбъект = Объект.Ссылка.ПолучитьОбъект();
	ЗадачаОбъект.ВыполнитьЗадачу();
	
КонецПроцедуры // ЗапмсатьВыполнениеНаСервере()  

#Область Команды

&НаКлиенте
Процедура НачатьВыполнение(Команда)
	
	Если ЗначениеЗаполнено(Объект.Исполнитель) Тогда
		
		Если Модифицированность Тогда
			Записать();
		КонецЕсли;
		
		ЗапуститьДействие("НачатьВыполнение");
		
	Иначе
		
		СтруктурайПользователь = омСотрудники.ПолучитьТекущегоПользователя(,Истина);
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаполненияИсполнителя", ЭтаФорма
								, Новый Структура("ТекущийПользователь", СтруктурайПользователь.ТекущийПользователь));
								
		ПоказатьВопрос(Оповещение, "Назначить исполнителем " + СтруктурайПользователь.Наименование, Режим, 0);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаполненияИсполнителя(Результат, Параметр) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Объект.Исполнитель = Параметр.ТекущийПользователь;
		Записать();
		ЗапуститьДействие("НачатьВыполнение");
	Иначе
		ПоказатьПредупреждение(,"Не заполнен Исполнитель");
	КонецЕсли;
	
КонецПроцедуры
 
&НаКлиенте
Процедура КорректировкаНеНужна(Команда)

	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ЗапуститьДействие("КорректировкаНеНужна"); 
	
КонецПроцедуры

