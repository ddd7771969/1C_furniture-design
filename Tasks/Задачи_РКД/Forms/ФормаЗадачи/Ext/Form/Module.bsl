&НаКлиенте
Процедура ПланРазработкиВДняхПриИзменении(Элемент)

	СтруктураДанных = ПолучитьПланРазработкиВДнях(Объект.Ссылка);
	
	Если ПланРазработкиВДнях > 0 И НЕ СтруктураДанных.ДатаНачала = Дата(1, 1, 1) Тогда
		
		Элементы.ДекорацияДатаОкончания.Видимость = Истина;
		Элементы.ДекорацияДатаОкончания.Заголовок = "Дата окончания " + Формат(ТекущаяДата() + ПланРазработкиВДнях * 24 * 3600, "ДЛФ=DD");
		
	Иначе
		
		Элементы.ДекорацияДатаОкончания.Видимость = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКомментарияУвеличенияСрока(Строка, Параметры) Экспорт
	Если НЕ Строка = Неопределено Тогда
		КомментарийУвеличеияПродолжительности = Строка;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СбросКонструктором(Команда)
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ТекущиеДействие = "СбросКонструктором";
	омДлительныеОперцииНаКлиенте.ЗапускДлительногоДействия(Объект.Ссылка, ТекущиеДействие);
	ПодключитьОбработчикОжидания("КонтрольДлительногоДействия", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьООшибке(Команда)
	омЗадачаОбщаяНаКлиенте.ОткрытьПодготовленныюЗадачу(Объект.Ссылка);
КонецПроцедуры



#Область ДлительныеДействия

&НаКлиенте
Процедура ОбщаяКомандаДлительныеДействия(Команда)
	омДлительныеОперцииНаКлиенте.ОбщееДействие(ЭтаФорма, ТекущийЭлемент);
КонецПроцедуры 

&НаКлиенте
Процедура КонтрольДлительногоДействия()

	НаименованиеДействия = "";
	Если омФайлыPDM.КонтрольДлительнойОперации(НаименованиеДействия, Объект.Ссылка) Тогда
		
		ТолькоПросмотр = Истина;
		Элементы.Группа2.Доступность = Ложь;
		
		ПодключитьОбработчикОжидания("КонтрольДлительногоДействия", 0.5, Истина);
		
	Иначе
		
		Если Не ПустаяСтрока(ТекущиеДействие) Тогда
			
			Если Модифицированность Тогда
				Записать();
			КонецЕсли;
			
			стДанные = ДействияНаСервере(ТекущиеДействие, Объект.Ссылка, Объект.Исполнитель);
			ТекущиеСостояние 		= стДанные.Состояние;
			
		КонецЕсли;
		ТолькоПросмотр 					= Ложь;
		Элементы.Группа2.Доступность 	= Истина;
		ВидимостьИДоступностьЭлементов();
		ПриОткрытии(Ложь);
		ВидимостьКнопок();
		
	КонецЕсли;
	
	омДлительныеОперцииНаКлиенте.ВывестиДлителноеДействиеНаФорму(ЭтаФорма);
	
КонецПроцедуры // КонтрольДлительногоДействия()

	
#КонецОбласти

