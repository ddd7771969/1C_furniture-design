&НаКлиенте
Процедура ОбъектТЗПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОбъектТЗ) Тогда
		
		ДанныеКомпозиции = ПолучитьПроектНаСервере(Объект.ОбъектТЗ);
		
		Объект.Проект = ДанныеКомпозиции.Проект;

		Объект.Комплекты.Очистить();
		Для каждого х Из ДанныеКомпозиции.Комплекты Цикл
			ЗаполнитьЗначенияСвойств(Объект.Комплекты.Добавить(), х);
		КонецЦикла;
		
	Иначе
		Объект.Проект = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроектНаСервере(ОбъектТЗ)
	
	Возврат Задачи.ПересогласованиеКомпозиции.ПолучитьПроектНаСервере(ОбъектТЗ);	
	
КонецФункции // ПолучитьПроектНаСервере()


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Элементы.ОбъектТЗ.ТолькоПросмотр = НЕ Параметры.Ключ.Пустая();

	Заголовок = Объект.Наименование;
	
	
	Если Копирование Тогда
		Модифицированность 	= Истина;
		Объект.Выполнена 	= Ложь;
		
	ИначеЕсли Объект.Выполнена Тогда
		
		ТолькоПросмотр 							= Истина;
		Элементы.ФормаПринять.Видимость 		= Ложь;
		Элементы.ФормаЗаписатьЗадачу.Видимость 	= Ложь;
		
	КонецЕсли;
	
	ОбновитьСтадии(Неопределено);
	
КонецПроцедуры


Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	омКомментарииНаСервере.СоздатьЭлементыИРеквизитыНаФорме(ЭтаФорма, Элементы.ГруппаКомментарий);
	ДополнительныеПараметры = Неопределено;
	Этаформа.Комментарий_авто = омКомментарииНаСервере.Получить_HTML_комментарий(Объект.Комментарии, , , ДополнительныеПараметры);
	Элементы.ГруппаКомментарий.Заголовок = омКомментарийКлиентСервер.ПолучитьЗаголовокСтраницы(ДополнительныеПараметры);
	
	Копирование = ЗначениеЗаполнено(Параметры.ЗначениеКопирования);
	
КонецПроцедуры 


