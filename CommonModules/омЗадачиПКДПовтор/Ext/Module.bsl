КонецФункции // ДобавитьТипыЗадачВедущий()

Функция ПолучитьСписокСокращений() Экспорт

	мСписокИмен = Новый Массив;
	ОбъектОтчета = Отчеты.ОбщиеНастройки.Создать();
	ОбъектОтчета.ДобавитьСписокИменНаименованияКомплекта(мСписокИмен);
	
	СтруктураСокращений = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПроекта.ИмяНастройки КАК ИмяНастройки,
		|	НастройкиПроекта.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.НастройкиПроекта КАК НастройкиПроекта
		|ГДЕ
		|	НастройкиПроекта.ИмяНастройки В(&мСписокИмен)
		|	И НастройкиПроекта.НомерНастройки = 0
		|	И НЕ НастройкиПроекта.Значение = """"
		|	И НастройкиПроекта.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("мСписокИмен", мСписокИмен);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураСокращений.Вставить(Выборка.ИмяНастройки, Выборка.Значение); 
	КонецЦикла;
	
	Возврат СтруктураСокращений;
	
КонецФункции // ПолучитьСписокСокращений()

Функция ПолучитьУровниНаименованияСтадии(СтадияКомплекта) Экспорт
	
	ДанныеУровней = Новый Структура("_1, _2, _3, _4", Истина, Истина, Истина, Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтадииКомплекта.ВыводитьПервыйУровеньВНаименовании КАК _1,
		|	СтадииКомплекта.ВыводитьВторойУровеньВНаименовании КАК _2,
		|	СтадииКомплекта.ВыводитьТретийУровеньВНаименовании КАК _3,
		|	СтадииКомплекта.ВыводитьЧетвертыйУровеньВНаименовании КАК _4
		|ИЗ
		|	Справочник.СтадииКомплекта КАК СтадииКомплекта
		|ГДЕ
		|	СтадииКомплекта.Ссылка = &СтадияКомплекта
		|	И (СтадииКомплекта.ВыводитьПервыйУровеньВНаименовании
		|			ИЛИ СтадииКомплекта.ВыводитьВторойУровеньВНаименовании
		|			ИЛИ СтадииКомплекта.ВыводитьТретийУровеньВНаименовании
		|			ИЛИ СтадииКомплекта.ВыводитьЧетвертыйУровеньВНаименовании)";
	
	Запрос.УстановитьПараметр("СтадияКомплекта", СтадияКомплекта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДанныеУровней, Выборка);
	КонецЦикла;
	
	Возврат ДанныеУровней;
	
КонецФункции // ПолучитьУровниНаименованияСтадии()
