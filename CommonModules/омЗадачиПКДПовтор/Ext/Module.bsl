Функция ПолучитьКоличествоРазрешенныхЗадачПКДВРаботе() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПроекта.Значение КАК КоличествоЗадачПКДВРаботе
		|ИЗ
		|	РегистрСведений.НастройкиПроекта КАК НастройкиПроекта
		|ГДЕ
		|	НастройкиПроекта.ИмяНастройки = ""КоличествоЗадачПКДВРаботе""
		|	И НастройкиПроекта.НомерНастройки = 0
		|	И НастройкиПроекта.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.КоличествоЗадачПКДВРаботе;
	КонецЦикла;
	
	Возврат 2;
	
КонецФункции // ПолучитьКоличествоЗадачПКДВРаботе()   

Функция ТипыЗадачКонструктора(ФиксированныйМассив = Истина) Экспорт
	
	КоличествоЭлементов = 1;
	
	Если ФиксированныйМассив Тогда
		ТипыЗадачКонструктора = Новый Массив(КоличествоЭлементов);
	Иначе
	    ТипыЗадачКонструктора = Новый Массив;
		
		Для х = 1 По КоличествоЭлементов Цикл
			ТипыЗадачКонструктора.Добавить(Неопределено);
		КонецЦикла;
	
	КонецЕсли;
	
	ТипыЗадачКонструктора[0] = Перечисления.ТипыЗадачКонструирования.Конструктор;

	Возврат ТипыЗадачКонструктора;

КонецФункции // ТипыЗадачКонструктора()

Функция СтадииКонструктора(ИспользоватьПаузу = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтадииКомплектаРеквизитыСтадии.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтадииКомплекта.РеквизитыСтадии КАК СтадииКомплектаРеквизитыСтадии
		|ГДЕ
		|	СтадииКомплектаРеквизитыСтадии.ТипЗадачи = ЗНАЧЕНИЕ(Перечисление.ТипыЗадачКонструирования.Конструктор)";
	
	Если НЕ ИспользоватьПаузу Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ СтадииКомплектаРеквизитыСтадии.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияЗадач.ПриостановкаКонструктором))";
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции // ТипыЗадачьКонструктора()

Функция ПолучитьСтадииКомплектов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтадииКомплектаРеквизитыСтадии.Статус КАК Статус,
		|	СтадииКомплектаРеквизитыСтадии.ТипЗадачи КАК ТипЗадачи,
		|	СтадииКомплектаРеквизитыСтадии.Состояние КАК Состояние,
		|	СтадииКомплектаРеквизитыСтадии.Ссылка КАК Стадия,
		|	СтадииКомплектаРеквизитыСтадии.Ссылка.Наименование КАК Наименование
		|ИЗ
		|	Справочник.СтадииКомплекта.РеквизитыСтадии КАК СтадииКомплектаРеквизитыСтадии
		|ГДЕ
		|	НЕ СтадииКомплектаРеквизитыСтадии.Ссылка.ПометкаУдаления";
	
	Возврат Запрос.Выполнить().Выгрузить();
	

КонецФункции // ПолучитьСтадииКомплектов()

