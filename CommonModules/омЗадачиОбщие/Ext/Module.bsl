Функция ПолучитьЗадачуПоОбъекту(ОбъектЗадачи, ТолькоНеВыполненые = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Задачи_ПКД.Ссылка, ЗНАЧЕНИЕ(Задача.Задачи_ПКД.ПустаяСсылка)) КАК Задачи,
		|	ВЫБОР
		|		КОГДА Задачи_ПКД.ТипЗадачи = ЗНАЧЕНИЕ(Перечисление.ТипыЗадачКонструирования.Конструктор)
		|				И НЕ(ТаймингЗадачСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗадач.ОжиданиеКонструктором)
		|						ИЛИ ТаймингЗадачСрезПоследних.Состояние ЕСТЬ NULL
		|						ИЛИ ТаймингЗадачСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗадач.ПустаяСсылка))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Задача_у_Конструктора
		|ИЗ
		|	Задача.Задачи_ПКД КАК Задачи_ПКД
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТаймингЗадач.СрезПоследних КАК ТаймингЗадачСрезПоследних
		|		ПО Задачи_ПКД.Ссылка = ТаймингЗадачСрезПоследних.Задача
		|ГДЕ
		|	Задачи_ПКД.ОбъектТЗ = &ОбъектТЗ
		|	И ВЫБОР
		|			КОГДА &ТолькоНеВыполненые
		|				ТОГДА НЕ Задачи_ПКД.Выполнена
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(Задачи_РКД.Ссылка, ЗНАЧЕНИЕ(Задача.Задачи_РКД.ПустаяСсылка)),
		|	ВЫБОР
		|		КОГДА Задачи_РКД.ТипЗадачи = ЗНАЧЕНИЕ(Перечисление.ТипыЗадачКонструирования.Конструктор)
		|				И НЕ(ТаймингЗадачСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗадач.ОжиданиеКонструктором)
		|						ИЛИ ТаймингЗадачСрезПоследних.Состояние ЕСТЬ NULL
		|						ИЛИ ТаймингЗадачСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗадач.ПустаяСсылка))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|ИЗ
		|	Задача.Задачи_РКД КАК Задачи_РКД
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТаймингЗадач.СрезПоследних КАК ТаймингЗадачСрезПоследних
		|		ПО Задачи_РКД.Ссылка = ТаймингЗадачСрезПоследних.Задача
		|ГДЕ
		|	Задачи_РКД.ОбъектТЗ = &ОбъектТЗ
		|	И ВЫБОР
		|			КОГДА &ТолькоНеВыполненые
		|				ТОГДА НЕ Задачи_РКД.Выполнена
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ТолькоНеВыполненые", ТолькоНеВыполненые);
	Запрос.УстановитьПараметр("ОбъектТЗ", 			ОбъектЗадачи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ТолькоНеВыполненые Тогда
			
			Если ЗначениеЗаполнено(Выборка.Задачи) Тогда
				Возврат Новый Структура("Задача, РаботаКонструктора", Выборка.Задачи, Выборка.Задача_у_Конструктора);	
			КонецЕсли;
			
		Иначе
			
			
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат Неопределено
	
КонецФункции // ПолучитьЗадачуПоОбъекту()

Процедура ЗаполнитьНачальныеДанныеЗадачиБагТрек(ДанныеФормы) Экспорт

	ДанныеФормы.ТипЗадачи 		= Перечисления.ТипыОбщихЗадач.Информация;
	
	Если ЗначениеЗаполнено(ДанныеФормы.ОбъектАдресации) Тогда
	
		ДанныеФормы.Проект = ДанныеФормы.ОбъектАдресации.Проект;	
	
	КонецЕсли;

КонецПроцедуры

Функция ВыполнитьДействиеДляКомплекта(УИДДействия, ДействиПриЗавершении) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДлительныеДействия.ОбъектДействия КАК ОбъектДействия
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РегистрСведений.ДлительныеДействия КАК ДлительныеДействия
		|ГДЕ
		|	ДлительныеДействия.УИДДействия = &УИДДействия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Задачи_РКД.Ссылка КАК ЗадачаРКД
		|ИЗ
		|	вт КАК вт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.Задачи_РКД КАК Задачи_РКД
		|		ПО вт.ОбъектДействия = Задачи_РКД.ОбъектТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт.ОбъектДействия КАК ОбъектДействия
		|ИЗ
		|	вт КАК вт";
	
	Запрос.УстановитьПараметр("УИДДействия", УИДДействия);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбъектДействия = Неопределено;
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектДействия = Выборка.ОбъектДействия;
	КонецЦикла; 
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗадачаРКД = Выборка.ЗадачаРКД;
	КонецЦикла; 
	
	Если НЕ ЗначениеЗаполнено(ОбъектДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДействиПриЗавершении = "ПереносВ_ПКД_ДизайнеромКорректировкаДизайнера" ИЛИ ДействиПриЗавершении = "ПереносВ_ПКД_ДизайнеромИзменениеЗаказчиком" Тогда
		
		Попытка
		
			Задачи.ПересогласованиеКомпозиции.СоздатьЗадачуПересоглосования(ОбъектДействия, ДействиПриЗавершении); 
		
		Исключение
			в = ОписаниеОшибки();	
 		КонецПопытки;
		
	ИначеЕсли ДействиПриЗавершении = "СбросДизайнеромКорректировкаДизайнера" ИЛИ ДействиПриЗавершении = "СбросДизайнеромИзменениеЗаказчиком" Тогда
		
		СтатусыДействия = омЗадачиПКДСервер.ПолучитьСтатусЗадачиПоДействию(ДействиПриЗавершении);
		Конструктор = омСотрудники.ПолучитьКонструктораРазработкиПользовательПоОбъекту(ОбъектДействия);
		Задачи.Задачи_ПКД.СоздатьЗадачуРКД(ОбъектДействия, Конструктор, СтатусыДействия.Статус, СтатусыДействия.Тип, Перечисления.СостоянияЗадач.ОжиданиеКонструктором);
		
		Если омКанбанПроизводство.РесурсВПроизводстве(ОбъектДействия) Тогда
			
			УИДКарточка = "";
			
			омКанбанПроизводство.ПеревестиКарточкуВПриостановку(ОбъектДействия, , УИДКарточка);
			омКанбанДоскиНаСервере.ЗаписатьТег(Справочники.Теги.Пересогласование, УИДКарточка);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // Перемемистить_задачу_с_РКД_в_ПКД(ЗадачаКомплект)   

Функция ПолучитьрежимРаботыИсполнителяЗадачи(Задача) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Задачи_РКД.ОбъектТЗ КАК ОбъектТЗ
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	Задача.Задачи_РКД КАК Задачи_РКД
		|ГДЕ
		|	Задачи_РКД.Ссылка = &Задача
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеСотрудниковСрезПоследних.РежимРаботы КАК РежимРаботы
		|ИЗ
		|	вт КАК вт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКомплекта.СрезПоследних КАК ДанныеКомплектаСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников.СрезПоследних КАК ДанныеСотрудниковСрезПоследних
		|			ПО ДанныеКомплектаСрезПоследних.Конструктор = ДанныеСотрудниковСрезПоследних.Сотрудник
		|		ПО вт.ОбъектТЗ = ДанныеКомплектаСрезПоследних.Комплект";
	
	
	Если ТипЗнч(Задача) = Тип("ЗадачаСсылка.Задачи_ПКД") Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Задачи_РКД", "Задачи_ПКД");	
	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Задача", Задача);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.РежимРаботы;
	КонецЦикла;
	
	Возврат Перечисления.РежимыРаботы.ПустаяСсылка();

КонецФункции // получитьрежимРаботыИсполнителяЗадачи()

Функция ПолучитьНаименованиеЗадачи(Задача, Знач СтатусЗадачи = Неопределено, Знач ТипЗадачи = Неопределено, Знач СостояниеЗадачи = Неопределено, Комплект = Неопределено) Экспорт
	
	ТипЗадачиПКД = "П";
	ТипЗадачиРКД = "Р";
	
	Если ТипЗнч(Задача) = Тип("ЗадачаСсылка.Задачи_ПКД") Тогда
		ТипЗадачиСтрокой 		= ТипЗадачиПКД; 
		СтатусЗадачиУмолчание	= Перечисления.СтатусыЗадач.Разработка;
	Иначе	
		ТипЗадачиСтрокой 		= ТипЗадачиРКД;
		СтатусЗадачиУмолчание	= Перечисления.СтатусыЗадач.РазработкаРКД;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Задача) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаймингЗадачСрезПоследних.Задача.ОбъектТЗ.Наименование КАК ОбъектТЗНаименование,
			|	ТаймингЗадачСрезПоследних.Состояние КАК СостояниеЗадачи,
			|	ТаймингЗадачСрезПоследних.ТипЗадачи КАК ТипЗадачи,
			|	ТаймингЗадачСрезПоследних.Статус КАК СтатусЗадачи,
			|	ДатыКомплекта.НомерДоработка КАК НомерДоработка,
			|	ДатыКомплекта.НомерПКД + 1 КАК НомерПКД,
			|	ДатыКомплекта.НомерРКД + 1 КАК НомерРКД,
			|	ДатыКомплекта.Рекламация КАК Рекламация,
			|	ДатыКомплекта.НомерИзменение КАК НомерИзменение,
			|	ДатыКомплекта.НомерКорректировка КАК НомерКорректировка
			|ИЗ
			|	РегистрСведений.ТаймингЗадач.СрезПоследних(, Задача = &Задача) КАК ТаймингЗадачСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыКомплекта КАК ДатыКомплекта
			|		ПО ТаймингЗадачСрезПоследних.Задача.ОбъектТЗ = ДатыКомплекта.Комплект";
		
		
		Запрос.УстановитьПараметр("Задача", Задача);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НаименованиеКомплекта 	= Выборка.ОбъектТЗНаименование;
			СтатусЗадачи			= ?(СтатусЗадачи 	= Неопределено, Выборка.СтатусЗадачи, 		СтатусЗадачи);
			ТипЗадачи				= ?(ТипЗадачи 		= Неопределено, Выборка.ТипЗадачи, 			ТипЗадачи);
			СостояниеЗадачи			= ?(СостояниеЗадачи = Неопределено, Выборка.СостояниеЗадачи, 	СостояниеЗадачи); 
			НомерПКД				= Выборка.НомерПКД;
			НомерРКД				= Выборка.НомерРКД;
			НомерДоработка			= Выборка.НомерДоработка;
			НомерИзменение			= Выборка.НомерИзменение;
			НомерКорректировка		= Выборка.НомерКорректировка;
			Рекламация				= Выборка.Рекламация;
		КонецЦикла;
		
	Иначе
		
		НаименованиеКомплекта 	= Комплект.Наименование;
		СтатусЗадачи			= ?(СтатусЗадачи 	= Неопределено, СтатусЗадачиУмолчание, 								СтатусЗадачи);
		СостояниеЗадачи			= ?(СостояниеЗадачи = Неопределено, Перечисления.СостоянияЗадач.ОжиданиеКонструктором, 	СостояниеЗадачи);
		ТипЗадачи				= ?(ТипЗадачи 		= Неопределено, Перечисления.ТипыЗадачКонструирования.Конструктор,	ТипЗадачи);
		НомерПКД 				= 1;
		НомерРКД 				= 1;
		НомерДоработка			= 0;
		НомерИзменение			= 0;
		НомерКорректировка		= 0;
		Рекламация				= Ложь;
	КонецЕсли;
	
	ЗначениеСтатуса = "";
	
	Если СтатусЗадачи = Перечисления.СтатусыЗадач.Изменение ИЛИ СтатусЗадачи = Перечисления.СтатусыЗадач.ИзменениеРКД Тогда
		ЗначениеСтатуса = "Изменение";	
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.Корректировка ИЛИ СтатусЗадачи = Перечисления.СтатусыЗадач.КорректировкаРКД Тогда
		ЗначениеСтатуса = "Корректировка";
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.Разработка ИЛИ СтатусЗадачи = Перечисления.СтатусыЗадач.РазработкаРКД Тогда
		ЗначениеСтатуса = "Разработка";
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.ОжиданиеГЧ Тогда
		ЗначениеСтатуса = "ОжиданиеГЧ";
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.ЗавершенаЗадача Тогда
		ЗначениеСтатуса = "Завершена";	
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.Согласование Тогда
		ЗначениеСтатуса = "Согласование";
	КонецЕсли;
	
	ПолноеНаименованиеСтадии = "";
	СтадияКомплекта = омЗадачиПКДСервер.ПолучитьСтруктуруСтадий(СтатусЗадачи);
	СтадияКомплекта.ТекущиеСостояние = СостояниеЗадачи;
	СтадияКомплекта.ТекущийТипЗадачи = ТипЗадачи;
	омЗадачиПКДСервер.ПолучитьСтадиюКомплеткаНаОснованииПараметров(СтадияКомплекта, ПолноеНаименованиеСтадии);
	
	Если ТипЗадачи = Перечисления.ТипыЗадачКонструирования.Конструктор Тогда
	
		Если НомерДоработка > 0 Тогда
		
			ЗначениеСтатуса = "Доработка" + Формат(НомерДоработка, "ЧГ=0");		
		
		ИначеЕсли ЗначениеСтатуса = "Изменение" Тогда
		
			ЗначениеСтатуса = "Изменение" + ?(НомерИзменение = 0, "", Формат(НомерИзменение, "ЧГ=0"));		
		
		ИначеЕсли ЗначениеСтатуса = "Корректировка" Тогда
		
			ЗначениеСтатуса = "Корректировка" + ?(НомерКорректировка = 0, "", Формат(НомерКорректировка, "ЧГ=0"));		
		
		КонецЕсли;
		
		
	
	Иначе
	
		Если ЗначениеСтатуса = "Изменение" Тогда
		
			ЗначениеСтатуса = "Изменение" + ?(НомерИзменение = 0, "", Формат(НомерИзменение, "ЧГ=0"));		
		
		ИначеЕсли ЗначениеСтатуса = "Корректировка" Тогда
		
			ЗначениеСтатуса = "Корректировка" + ?(НомерКорректировка = 0, "", Формат(НомерКорректировка, "ЧГ=0"));		
		
		КонецЕсли;
		
	КонецЕсли;
	
	НомерЗадачи = Формат(НомерПКД, "ЧГ=0");
	
	Если ТипЗадачиСтрокой = ТипЗадачиРКД Тогда
		НомерЗадачи =  Формат(НомерРКД, "ЧГ=0") + "." + НомерЗадачи;	
	КонецЕсли;
	
	Если Рекламация Тогда
	
		ЗначениеСтатуса = ".Рекламация." + ЗначениеСтатуса;	
	
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПолноеНаименованиеСтадии) Тогда
	
		ЗначениеСтатуса = ЗначениеСтатуса + "." + ПолноеНаименованиеСтадии;	
	
	КонецЕсли;
	
	Возврат СтрШаблон("%1.%2%3.%4", НаименованиеКомплекта, ТипЗадачиСтрокой, НомерЗадачи, ЗначениеСтатуса);

КонецФункции // ПолучитьНаименованиеЗадачи()

Процедура ИзменитьНаименованиеЗадачи(Задача) Экспорт
	
	Если ЗначениеЗаполнено(Задача) Тогда
		
		ЗадачаОбъект = Задача.ПолучитьОбъект();
		ЗадачаОбъект.Наименование = ПолучитьНаименованиеЗадачи(Задача);
		ЗадачаОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры


