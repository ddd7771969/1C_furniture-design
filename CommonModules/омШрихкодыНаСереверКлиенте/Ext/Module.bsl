//ОписаниеПрефикса
//Если первая цифра 0, то следующая код объекта, следующие код элемента
//Если первая цифра 1, то следующие две цифрв код объекта, следующие код элемента


Функция ПолучитьПрефиксШтрихкодаПоТипу(ОбъектОпределения) Экспорт

	ТипОбъекта = ТипЗнч(ОбъектОпределения);
	
	Если ТипОбъекта = Тип("СправочникСсылка.Образец") Тогда
		Возврат "01";
	КонецЕсли;

КонецФункции // ПолучитьПрефиксШтрихкодаПоТипу()
