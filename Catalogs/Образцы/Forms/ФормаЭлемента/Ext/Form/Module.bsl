#Область Картинки

&НаКлиенте
Перем МассивИменВременныхФайлов;
&НаКлиенте
Перем  ВсегоКартинок Экспорт;
&НаКлиенте
Перем НомерКартинки Экспорт;
&НаКлиенте
Перем НастройкиТекущейФормы Экспорт;

&НаКлиенте
Процедура ОбщаяКомандаКартинка(Команда)
	омКартинкиНаКлиенте.ОбщееДействие(ЭтаФорма, ТекущийЭлемент, НомерКартинки, , МассивИменВременныхФайлов); 
КонецПроцедуры 

&НаКлиенте
Процедура ОбщаяКомандаНастройкаКартинки(Команда)
	омКартинкиНаКлиенте.ОбщееДействие(ЭтаФорма, ТекущийЭлемент, НомерКартинки, ,МассивИменВременныхФайлов); 
КонецПроцедуры 

&НаКлиенте
Процедура ИнформацияОКартинках(ТекущийНомерКартинки = 0)

	ИмяСозданогоВременногоФайла = Новый Массив;
	ВсегоКартинок = омКартинкиНаСервере.ПолучитьИнформациюОКартинках(Объект.Ссылка, Истина);
	НомерКартинки = ТекущийНомерКартинки;

КонецПроцедуры // ИнформацияОКартинках()

//
&НаКлиенте
Процедура ВывестиКартинку()

	ИнформацияОКартинках();
	Если ВсегоКартинок = 0 Тогда
		Элементы.КартинкуВлево.Доступность 	= Ложь;	
		Элементы.КартинкуВправо.Доступность = Ложь;	
	Иначе
		омКартинкиНаКлиенте.ВывестиКартинку(Объект.Ссылка, НомерКартинки, ЭтаФорма, ВсегоКартинок);
	КонецЕсли;

КонецПроцедуры // ВывестиКартинку()

#КонецОбласти

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	омЗаполнениеРеквизиов.ЗаполнитьРеквизитыСтандартные(Объект);
	
	Элементы.ВариантыПечати.СписокВыбора.ЗагрузитьЗначения(Справочники.Образцы.ПолучитьМассивВариантыНастроек());
	
	Если Элементы.ВариантыПечати.СписокВыбора.Количество() > 0 Тогда
	
		ВариантыПечати = Элементы.ВариантыПечати.СписокВыбора[0];	
	
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		Элементы.ГруппаКартинки.Видимость 				= Ложь;
		Элементы.ДекорацияНеобходимоЗаписать.Видимость 	= Истина;
	Иначе
		Элементы.ДекорацияНеобходимоЗаписать.Видимость 	= Ложь;
		ЗаполнитьКомплекты();
	КонецЕсли;
	
	омКартинкиНаСервере.СоздатьЭлементыИРеквизитыНаФорме(ЭтаФорма, Элементы.ГруппаКартинки);
	
	Если РольДоступна("Программист") Тогда
		СоздадьКомандуШильдикИКнопку(Элементы.НастройкиКартинки, "Шильдик", "Шильдик"); 
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздадьКомандуШильдикИКнопку(ЭлементГруппа, Заголовок, ИмяКоманды)
	
	КомандаДобавитьКартинка 			= ЭтаФорма.Команды.Добавить(ИмяКоманды);
	КомандаДобавитьКартинка.Заголовок 	= Заголовок;
	КомандаДобавитьКартинка.Действие 	= ИмяКоманды;
	
	КнопкаДобавитьНастройка 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементГруппа);
	КнопкаДобавитьНастройка.Заголовок 	= Заголовок;
	КнопкаДобавитьНастройка.ИмяКоманды 	= ИмяКоманды;
	КнопкаДобавитьНастройка.Отображение	= ОтображениеКнопки.КартинкаИТекст;
	КнопкаДобавитьНастройка.Картинка	= БиблиотекаКартинок.Настройка;
	
КонецПроцедуры

&НаКлиенте
Процедура Комплекты1ПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Комплекты1ПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Комплекты1ПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

Процедура ЗаполнитьКомплекты()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИзделияКомплектОбразцы.Ссылка КАК Ссылка,
		|	ИзделияКомплектОбразцы.Ссылка.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ИзделияКомплект.Образцы КАК ИзделияКомплектОбразцы
		|ГДЕ
		|	ИзделияКомплектОбразцы.Образец = &Образец
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	Запрос.УстановитьПараметр("Образец", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Комплекты.Добавить(Выборка.Ссылка, Выборка.Наименование);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

#Область Картинки
	НастройкиКартинки 			= Неопределено;
	МассивИменВременныхФайлов 	= Новый Массив;
	ВывестиКартинку();
#КонецОбласти

	Элементы.ФормаПечатьШильдика.Доступность 	= ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.НастройкиКартинки.Доступность		= Элементы.ФормаПечатьШильдика.Доступность;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ИзменилииКартинкиОбъектТЗ" И Параметр.ОбъектТЗ = Объект.Ссылка Тогда
		
		ВывестиКартинку();
		
	Иначе
	
		
	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Элементы.ГруппаКартинки.Видимость 				= Истина;
	Элементы.ДекорацияНеобходимоЗаписать.Видимость 	= Ложь;
	Элементы.ФормаПечатьШильдика.Доступность 		= Истина;
	Элементы.НастройкиКартинки.Доступность			= Истина;
КонецПроцедуры

&НаКлиенте
Процедура Шильдик(Команда)
	Если Модифицированность Тогда
	   	ПоказатьПредупреждение(, "Перед печатью шильдика необходимо сохранить образец.");
	Иначе	
		ОткрытьФорму("Справочник.Образцы.Форма.ФормаШильдик", Новый Структура("Образец", Объект.Ссылка), ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьШильдика(Команда)
	
	ИдентификаторПечатнойФормы = "ШилдикОбразца";
	НазваниеПечатнойФормы = НСтр("ru = 'Шильдик образца'");
	
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета 		= НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент 	= ПолучитьФормуШильдик(Объект.Ссылка, ВариантыПечати);
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
	
	ОбластиОбъектов = Новый СписокЗначений;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);

КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьФормуШильдик(Образец, ИмяВарианта)
	
	Пример = Новый ТабличныйДокумент;
	
	ДанныеОбразца = Справочники.Образцы.ПолучитьДанныеОбразца(Образец);
	
	СтркутураНастроекПечати 					= Справочники.Образцы.ПолучитьВариантНастройки(ИмяВарианта);
	СтркутураНастроекПечати.ТекстНаименование	= ДанныеОбразца.Наименование;
	Справочники.Образцы.СформироватьТаблицуНаСервере(Образец, СтркутураНастроекПечати, Пример);

   	Возврат Пример;
	
КонецФункции // ПолучитьФормуШильдик()


