Процедура УдалитьВариант(Команда)
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариант(Команда)
	
	Если ПустаяСтрока(ВариантНастройки) Тогда
	
		ПоказатьПредупреждение(, "Не выбран вариант.");	
	
	Иначе
	
		Модифицированность = Ложь;
		СтатусИзменения		= 2;
		ЗаполнитьЗначенияСвойств(СтруктураВариантов[ВариантНастройки], ЭтаФорма);
		
		ЗаписатьНеСервере(СтруктураВариантов[ВариантНастройки], ВариантНастройки);

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьНеСервере(ВариантНастройки, ИмяВарианта)

	Справочники.Образцы.ЗаписатьВариантНастройки(ВариантНастройки, ИмяВарианта);	

КонецПроцедуры


&НаКлиенте
Процедура ВариантНастройкиПриИзменении(Элемент)
	
	Элементы.Группа1.ТолькоПросмотр = Ложь;
	Элементы.Печать.Доступность 	= Истина; 
	СтатусИзменения		= 2;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантНастройкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Если Модифицированность Тогда
		
		СтандартнаяОбработка = Ложь;
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма);
		ПоказатьВопрос(Оповещение, "Настройки изменены. Если продолжить, то изменения не будут сохранены. Продолжить?", Режим, 0);
		
	КонецЕсли;
	
КонецПроцедуры

 &НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        Модифицированность = Ложь;
		СтатусИзменения		= 2;
   КонецЕсли;

КонецПроцедуры


