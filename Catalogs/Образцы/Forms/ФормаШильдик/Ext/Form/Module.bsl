&НаКлиенте
Процедура Печать(Команда)
	
	ИдентификаторПечатнойФормы = "ШилдикОбразца";
	НазваниеПечатнойФормы = НСтр("ru = 'Шильдик образца'");
	
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета = НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент = Пример;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
	
	ОбластиОбъектов = Новый СписокЗначений;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВариантНастройки(Команда)

	ПослеВводаВарианта = Новый ОписаниеОповещения("ПослеВводаНаименованиеВарианта", ЭтаФорма);
	ПоказатьВводСтроки(ПослеВводаВарианта, "", "Наименование варианта", 100);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВводаНаименованиеВарианта(ИмяВарианта, ДполнительыеЗначения) Экспорт

	ИмяВарианта = СтрЗаменить(ИмяВарианта, " ", "_");
	ИмяВарианта = СтрЗаменить(ИмяВарианта, ".", "_");
	ИмяВарианта = СтрЗаменить(ИмяВарианта, ",", "_");
	ИмяВарианта = СтрЗаменить(ИмяВарианта, "!", "_");
	ИмяВарианта = СтрЗаменить(ИмяВарианта, """", "_");
	ИмяВарианта = СтрЗаменить(ИмяВарианта, "№", "_");
	
	Если ЗначениеЗаполнено(ИмяВарианта) Тогда
		
		Если Элементы.ВариантНастройки.СписокВыбора.НайтиПоЗначению(ИмяВарианта) = Неопределено Тогда
			Элементы.УдалитьВариант.Доступность = Истина;
			Элементы.ВариантНастройки.СписокВыбора.Добавить(ИмяВарианта);
		Иначе	
			ПоказатьПредупреждение(, "Вариант " + ИмяВарианта + " уже существует");
		КонецЕсли;	
		
	КонецЕсли;
	

КонецПроцедуры // ПослеВводаНаименованиеВарианта()

