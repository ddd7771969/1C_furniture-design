	СформироватьТаблицуНаСервере(Образец, СтркутураНастроекПечати, Пример, ДанныеОбразца); 
	
	Модифицированность 	= Истина;
	
	СтатусИзменения		= 1;

КонецПроцедуры // ПриИзмененииНастроек()

