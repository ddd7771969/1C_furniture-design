&НаКлиенте
Процедура НачальныеНастройки()

	РазмерШрифтаНаименования 	= ?(РазмерШрифтаНаименования = 0, 	9,  РазмерШрифтаНаименования);
	РазмерШрифтаОбработка 		= ?(РазмерШрифтаОбработка = 0, 		8,  РазмерШрифтаОбработка);
	РазмерШрифтаМатериалы 		= ?(РазмерШрифтаМатериалы = 0, 		8,  РазмерШрифтаМатериалы);
	РазмерШКпоВысоте			= ?(РазмерШКпоВысоте = 0,			7,  РазмерШКпоВысоте);
	РазмерШКпоШирине			= ?(РазмерШКпоШирине = 0,			15, РазмерШКпоШирине);

КонецПроцедуры // НачальныеНастройки() 

