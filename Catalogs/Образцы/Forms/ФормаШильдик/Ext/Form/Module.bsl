&НаКлиенте
Перем ДанныеОбразца, СтруктрураОбъеденненыхЯчеек, СтркутураНастроекПечати, СтруктураВариантов, СтруктураПечати, Префикс;

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Образец", Образец);
	
	Если НЕ ЗначениеЗаполнено(Образец) Тогда
		Отказ = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Префикс = "ПечатьШильдика_";
	
	НачальныеНастройки();
	ДанныеОбразца 				= ПолучитьДанныеОбразца(Образец);
	СтркутураНастроекПечати 	= ПолучитьСтруктуруПечати();
	ТекстНаименование 			= ДанныеОбразца.Наименование;
	СтруктураВариантов			= ПолучитьВариантыНастроек();

	ЗаполнитьВарианты();
	
	Элементы.УдалитьВариант.Доступность = СтруктураВариантов.Количество() > 0;
	
	Если ПустаяСтрока(ДанныеОбразца.Обработка) Тогда
	
		Элементы.ГруппаОбработка.ТолькоПросмотр = Истина;
		Элементы.Обработка.Видимость = Ложь;
	
	КонецЕсли;
	
	Если ДанныеОбразца.Материалы.Количество() = 0 Тогда
	
		Элементы.ГруппаМатериалы.ТолькоПросмотр = Истина;
		Элементы.Материалы.Видимость = Ложь;
	
	КонецЕсли;
	
	Элементы.Группа1.ТолькоПросмотр = Истина;
	Элементы.Печать.Доступность 	= Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВарианты()

	Элементы.ВариантНастройки.СписокВыбора.Очистить();
	
	Для каждого х Из СтруктураВариантов Цикл
	
		Элементы.ВариантНастройки.СписокВыбора.Добавить(х.Ключ); 
	
	КонецЦикла;
	
	Элементы.ВариантНастройки.СписокВыбора.СортироватьПоЗначению();
	
КонецПроцедуры


